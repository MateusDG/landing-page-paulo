---
import { getCollection, render } from 'astro:content';

import Base from '../../layouts/Base.astro';
import Croqui from '../../components/Croqui.astro';
import FichaTecnica from '../../components/FichaTecnica.astro';
import BotaoWhats from '../../components/BotaoWhats.astro';
import GaleriaImovel from '../../components/GaleriaImovel.astro';
import FichaImovel from '../../components/FichaImovel.astro';
import CotaDimensional from '../../components/CotaDimensional.astro';

import { rotuloTerritorio } from '../../data/territorios';
import { formatarArea, converter } from '../../lib/unidades';
import { preco, precoPorHa, descreverAcesso, dataCurta, mesAno } from '../../lib/format';

export async function getStaticPaths() {
  const imoveis = await getCollection('imoveis');
  return imoveis.map((imovel) => ({ params: { slug: imovel.id }, props: { imovel } }));
}

const { imovel } = Astro.props;
const d = imovel.data;
const areaHa = d.areaHa;
const areaConhecida = areaHa != null;
const { Content } = await render(imovel);

const vendida = d.status === 'vendida';

/* Sugestões: mesma região primeiro, depois faixa de área parecida.
   Imóvel vendido nunca vira beco sem saída, sempre aponta para similares. */
const todos = await getCollection('imoveis');
const similares = todos
  .filter((i) => i.id !== imovel.id && i.data.status !== 'vendida')
  .sort((a, b) => {
    const mesmaRegiao = (x: typeof a) => (x.data.regiao === d.regiao ? 0 : 1);
    if (mesmaRegiao(a) !== mesmaRegiao(b)) return mesmaRegiao(a) - mesmaRegiao(b);
    return Math.abs((a.data.areaHa ?? 0) - (areaHa ?? 0)) - Math.abs((b.data.areaHa ?? 0) - (areaHa ?? 0));
  })
  .slice(0, 3);

const linhasFicha = [
  { rotulo: 'Código', valor: d.codigo },
  { rotulo: 'Município', valor: `${d.municipio}/ES` },
  { rotulo: 'Região', valor: rotuloTerritorio(d.regiao) },
  { rotulo: 'Área', valor: areaConhecida ? `${formatarArea(areaHa)} ha` : 'Área total a confirmar' },
  ...(areaConhecida
    ? [{
        rotulo: 'Equivalente',
        valor: `${converter(areaHa, 'alq').toLocaleString('pt-BR', {
          maximumFractionDigits: 1,
        })} alq`,
      }]
    : []),
  ...(d.tempoDeVitoria !== 'A confirmar'
    ? [{ rotulo: 'De Vitória', valor: d.tempoDeVitoria }]
    : []),
  ...(d.distanciaVitoriaKm
    ? [{ rotulo: 'Distância', valor: `${d.distanciaVitoriaKm} km` }]
    : []),
  ...(d.coordenada ? [{ rotulo: 'Coordenada', valor: d.coordenada }] : []),
];

const linhasCampo = [
  { rotulo: 'Água', valor: d.agua },
  { rotulo: 'Energia', valor: d.energia },
  ...(d.sinal ? [{ rotulo: 'Sinal', valor: d.sinal }] : []),
  ...(d.solo ? [{ rotulo: 'Solo', valor: d.solo }] : []),
  { rotulo: 'Acesso', valor: descreverAcesso(d.acesso.asfaltoKm, d.acesso.terraKm) },
];

const rotuloFinalidade: Record<string, string> = {
  produzir: 'Produção',
  morar: 'Moradia',
  lazer: 'Lazer',
  investir: 'Investimento',
  turismo: 'Turismo',
};

const paginaUrl = new URL(Astro.url.pathname, Astro.site).href;
const imagens = d.fotos.map((foto) => new URL(foto.src, Astro.site).href);
const nomeSeo = areaConhecida
  ? `${d.titulo}, ${formatarArea(areaHa)} ha`
  : d.titulo;
const descricaoSeo = d.resumo;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${paginaUrl}#imovel`,
  url: paginaUrl,
  name: nomeSeo,
  sku: d.codigo,
  description: d.resumo,
  image: imagens,
  category: 'Imóvel rural',
  additionalProperty: [
    ...(areaConhecida ? [{ '@type': 'PropertyValue', name: 'Área (ha)', value: areaHa }] : []),
    { '@type': 'PropertyValue', name: 'Município', value: d.municipio },
    { '@type': 'PropertyValue', name: 'Água', value: d.agua },
    { '@type': 'PropertyValue', name: 'Acesso', value: d.acesso.nota },
  ],
  ...(d.preco != null && {
    offers: {
      '@type': 'Offer',
      price: d.preco,
      priceCurrency: 'BRL',
      availability: vendida
        ? 'https://schema.org/SoldOut'
        : d.status === 'reservada'
          ? 'https://schema.org/LimitedAvailability'
          : 'https://schema.org/InStock',
      url: paginaUrl,
      seller: { '@id': `${Astro.site}#corretor` },
    },
  }),
};

const paginaLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  '@id': `${paginaUrl}#anuncio`,
  url: paginaUrl,
  name: nomeSeo,
  description: descricaoSeo,
  datePosted: d.publicadoEm.toISOString(),
  dateModified: d.atualizadoEm.toISOString(),
  ...(imagens.length ? { image: imagens, primaryImageOfPage: imagens[0] } : {}),
  about: { '@id': `${paginaUrl}#imovel` },
  inLanguage: 'pt-BR',
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Imóveis rurais', item: new URL('/imoveis/', Astro.site).href },
    {
      '@type': 'ListItem',
      position: 3,
      name: rotuloTerritorio(d.regiao),
      item: new URL(`/regiao/${d.regiao}/`, Astro.site).href,
    },
    { '@type': 'ListItem', position: 4, name: d.titulo, item: paginaUrl },
  ],
};
---

<Base
  titulo={nomeSeo}
  descricao={descricaoSeo}
  og={`/og/imovel-${imovel.id}.png`}
  ogTipo="product"
  jsonLd={[paginaLd, jsonLd, breadcrumb]}
>
  <article class="im">
    {/* --- Cabeçalho da ficha -------------------------------------------- */}
    <header class="im__cab secao--compacta">
      <div class="env">
        <nav class="im__trilha" aria-label="Você está em">
          <a href="/imoveis/">Imóveis</a>
          <span aria-hidden="true">/</span>
          <a href={`/regiao/${d.regiao}/`}>{rotuloTerritorio(d.regiao)}</a>
          <span aria-hidden="true">/</span>
          <span class="im__trilha-atual">{d.codigo}</span>
        </nav>

        <div class="im__topo">
          <div class="im__identidade">
            <div class="im__croqui">
              <Croqui
                path={d.croqui}
                viewBox={d.croquiViewBox}
                tamanho={200}
                desenhar
                norte
                rotulo={`Perímetro aproximado da área ${d.codigo}`}
              />
              <CotaDimensional
                valor={areaConhecida ? `${formatarArea(areaHa)} ha` : 'Área sob consulta'}
                class="im__cota"
              />
              <p class="rotulo rotulo--fraco im__croqui-nota">
                {d.croquiVerificado ? 'Perímetro simplificado' : 'Perímetro aproximado'}
              </p>
            </div>

            <div class="im__cabecalho-texto">
              {
                vendida && d.vendidaEm ? (
                  <p class="carimbo im__carimbo">Vendida {mesAno(d.vendidaEm)}</p>
                ) : d.status === 'reservada' ? (
                  <p class="rotulo im__reservada">Reservada</p>
                ) : (
                  <p class="rotulo rotulo--terra">Disponível</p>
                )
              }

              <h1 class="im__titulo">{d.titulo}</h1>

              <p class="im__area numero-chave">
                {areaConhecida ? formatarArea(areaHa) : 'Sob consulta'}
                {areaConhecida && <span class="im__unidade">ha</span>}
              </p>

              <p class="lead im__resumo">{d.resumo}</p>

              <ul class="im__tags">
                {
                  d.finalidade.map((f) => (
                    <li class="rotulo im__tag">{rotuloFinalidade[f] ?? f}</li>
                  ))
                }
              </ul>

              <div class="im__preco-bloco">
                <p class:list={['im__preco', 'mono', d.preco === null && 'im__preco--consulta']}>
                  {preco(d.preco)}
                </p>
                {
                  d.preco != null && areaConhecida && (
                    <p class="rotulo rotulo--fraco">{precoPorHa(d.preco, areaHa)}</p>
                  )
                }
              </div>

              {
                !vendida && (
                  <div class="im__acoes">
                    <BotaoWhats
                      imovel={d.codigo}
                      areaHa={areaHa ?? undefined}
                      municipio={d.municipio}
                      origem={`imovel:${d.codigo}`}
                      rotulo="Perguntar sobre esta área"
                    />
                  </div>
                )
              }
            </div>
          </div>

          <aside class="im__lateral">
            <FichaTecnica
              titulo="Ficha"
              linhas={linhasFicha}
              nota={`Conferido em campo · atualizado em ${dataCurta(d.atualizadoEm)}`}
            />
          </aside>
        </div>
      </div>
    </header>

    {/* --- Fotografia: contexto visual antes dos detalhes ---------------- */}
    <section class="secao--compacta" aria-labelledby="fotos-titulo">
      <div class="env">
        <h2 class="im__h2" id="fotos-titulo">Fotografia</h2>
        <GaleriaImovel fotos={[...d.fotos]} municipio={d.municipio} />
      </div>
    </section>

    {/* --- Dados de campo + benfeitorias ---------------------------------- */}
    <section class="secao--compacta" aria-labelledby="campo-titulo">
      <div class="env im__campo">
        <div>
          <h2 class="im__h2" id="campo-titulo">Dados de campo</h2>
          <FichaTecnica linhas={linhasCampo} variante="livre" />
          <p class="peq secundario im__acesso-nota">{d.acesso.nota}</p>
        </div>

        {
          d.benfeitorias.length > 0 && (
            <div>
              <h2 class="im__h2">Benfeitorias</h2>
              <ul class="im__benf">
                {d.benfeitorias.map((b) => (
                  <li class="im__benf-item">{b}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </section>

    {/* --- Descrição da área (corpo do markdown) -------------------------- */}
    <section class="secao--compacta im__notas-env" aria-labelledby="descricao-titulo">
      <div class="env">
        <div class="im__notas">
          <div class="im__notas-cab">
            <p class="rotulo rotulo--terra">Descrição</p>
            <h2 class="im__h2" id="descricao-titulo">Descrição da área</h2>
          </div>
          <div class="prosa im__notas-corpo">
            <Content />
          </div>
        </div>
      </div>
    </section>

    {/* --- Fecho ---------------------------------------------------------- */}
    <section class="secao--compacta im__fecho-env">
      <div class="env">
        {
          vendida ? (
            <div class="im__fecho">
              <h2 class="im__fecho-titulo">Esta área já foi vendida.</h2>
              <p class="lead">
                Mantenho a ficha no ar porque ela mostra o que passa pela minha
                carteira. Se procura algo parecido, me diga, áreas assim
                raramente ficam anunciadas.
              </p>
              <BotaoWhats
                origem={`imovel-vendido:${d.codigo}`}
                mensagem={`Oi, vi a ficha da área ${d.codigo} (${d.municipio}) que já foi vendida. Procuro algo parecido.`}
                rotulo="Procuro algo parecido"
              />
            </div>
          ) : (
            <div class="im__fecho">
              <h2 class="im__fecho-titulo">Quer ver essa área?</h2>
              <p class="lead">
                Agendo a visita e acompanho você pela área para apresentar suas
                características e possibilidades.
              </p>
              <div class="im__acoes">
                <BotaoWhats
                  imovel={d.codigo}
                  areaHa={areaHa ?? undefined}
                  municipio={d.municipio}
                  origem={`imovel-fecho:${d.codigo}`}
                  rotulo="Falar sobre esta área"
                />
              </div>
            </div>
          )
        }
      </div>
    </section>

    {/* --- Similares ------------------------------------------------------ */}
    {
      similares.length > 0 && (
        <section class="secao--compacta im__similares-env" aria-labelledby="similares-titulo">
          <div class="env">
            <h2 class="im__h2" id="similares-titulo">Áreas parecidas na carteira</h2>
            <div class="im__similares">
              {similares.map((s) => (
                <FichaImovel imovel={s} />
              ))}
            </div>
          </div>
        </section>
      )
    }
  </article>
</Base>

<style>
  .im__cab {
    border-bottom: var(--borda);
    padding-top: var(--s-6);
  }

  .im__trilha {
    display: flex;
    gap: var(--s-3);
    align-items: center;
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
    color: var(--grafite-40);
    margin-bottom: var(--s-7);
    flex-wrap: wrap;
  }

  .im__trilha a {
    text-decoration: none;
    color: var(--grafite-70);
  }

  .im__trilha a:hover {
    color: var(--terra);
  }

  .im__trilha-atual {
    color: var(--grafite);
  }

  .im__topo {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: var(--s-8);
    align-items: start;
  }

  .im__identidade {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-7);
    align-items: start;
  }

  .im__croqui {
    display: grid;
    gap: var(--s-4);
    width: 200px;
  }

  .im__croqui-nota {
    line-height: 1.5;
  }

  .im__carimbo,
  .im__reservada {
    display: inline-block;
  }

  .im__reservada {
    border: 1px solid var(--terra);
    color: var(--terra);
    padding: var(--s-1) var(--s-3);
  }

  .im__titulo {
    font-size: var(--t-h1);
    margin-top: var(--s-4);
    max-width: 18ch;
  }

  .im__area {
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    margin-top: var(--s-5);
    display: flex;
    align-items: baseline;
    gap: 0.1em;
  }

  .im__unidade {
    font-family: var(--f-mono);
    font-size: 0.22em;
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
    color: var(--grafite-70);
    transform: translateY(-0.4em);
  }

  .im__resumo {
    margin-top: var(--s-5);
    max-width: 52ch;
  }

  .im__tags {
    display: flex;
    gap: var(--s-2);
    flex-wrap: wrap;
    margin-top: var(--s-5);
  }

  .im__tag {
    border: var(--borda);
    padding: var(--s-2) var(--s-3);
    color: var(--grafite-70);
  }

  .im__preco-bloco {
    margin-top: var(--s-6);
    padding-top: var(--s-5);
    border-top: var(--borda);
    display: flex;
    align-items: baseline;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .im__preco {
    font-size: var(--t-h2);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .im__preco--consulta {
    font-size: var(--t-lead);
    font-weight: 500;
    color: var(--grafite-70);
  }

  .im__acoes {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    margin-top: var(--s-6);
  }

  .im__lateral {
    display: grid;
    gap: var(--s-6);
    position: sticky;
    top: var(--s-6);
  }

  /* --- Blocos gerais ---------------------------------------------------- */
  .im__h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--s-5);
  }

  .im__campo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: var(--s-8);
    align-items: start;
  }

  .im__acesso-nota {
    margin-top: var(--s-5);
    max-width: 54ch;
    line-height: 1.6;
  }

  .im__benf {
    border-top: var(--borda);
  }

  .im__benf-item {
    padding-block: var(--s-3);
    border-bottom: var(--borda-f);
    font-size: var(--t-peq);
  }

  .im__notas-env {
    border-block: var(--borda);
    background: var(--papel-2);
  }

  .im__notas {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-8);
    align-items: start;
  }

  .im__notas-corpo {
    max-width: 58ch;
  }

  .im__fecho-env {
    border-bottom: var(--borda);
  }

  .im__fecho {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    max-width: 56ch;
  }

  .im__fecho-titulo {
    font-size: var(--t-h2);
  }

  .im__similares {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 310px), 1fr));
    gap: var(--gutter);
  }

  @media (max-width: 1100px) {
    .im__topo {
      grid-template-columns: minmax(0, 1fr);
    }

    .im__lateral {
      position: static;
      max-width: 420px;
    }
  }

  @media (max-width: 760px) {
    .im__identidade,
    .im__falta,
    .im__notas {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }

    .im__croqui {
      width: 150px;
    }
  }
</style>
