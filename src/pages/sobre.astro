---
import Base from '../layouts/Base.astro';
import CabecalhoSecao from '../components/CabecalhoSecao.astro';
import BotaoWhats from '../components/BotaoWhats.astro';
import Croqui from '../components/Croqui.astro';
import { corretor } from '../data/site';
import { CONTORNO_ES, VIEWBOX_ES } from '../data/territorios';
import { numeroWhats } from '../lib/whatsapp';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  mainEntity: {
    '@type': 'Person',
    name: corretor.nome,
    jobTitle: corretor.papel,
    telephone: `+${numeroWhats}`,
    knowsAbout: [
      'Compra e venda de imóveis rurais',
      'Fazendas',
      'Chácaras',
      'Sítios',
      'Terrenos rurais',
    ],
  },
  inLanguage: 'pt-BR',
};
---

<Base
  titulo="Sobre"
  descricao={`${corretor.nome}, compra e venda de imóveis rurais no Espírito Santo. Atendimento direto para compradores e proprietários.`}
  jsonLd={jsonLd}
>
  <section class="secao--compacta sb__cab-env">
    <div class="env sb__topo">
      <div class="sb__retrato">
        <div class="sb__moldura">
          <Croqui path={CONTORNO_ES} viewBox={VIEWBOX_ES} tamanho={190} desenhar />
        </div>
      </div>

      <div class="sb__texto">
        <CabecalhoSecao
          kicker="Sobre"
          titulo="Compra e venda com atendimento pessoal"
          as="h1"
        />

        <div class="prosa">
          <p>
            Sou {corretor.nome} e atuo com compra e venda de imóveis rurais no Espírito Santo.
          </p>

          <p>
            O atendimento é feito diretamente comigo, desde o primeiro contato
            até a conclusão da negociação. Apresento cada oportunidade com
            clareza e acompanho compradores e proprietários em todas as etapas.
          </p>

          <h2>Conhecimento das regiões</h2>

          <p>
            Atuo em quatro regiões do Espírito Santo, cada uma com suas próprias
            características de relevo, produção, acesso e oportunidades: as{' '}
            <a href="/regiao/montanhas-capixabas/">Montanhas Capixabas</a>, o{' '}
            <a href="/regiao/norte-capixaba/">Norte</a>, o{' '}
            <a href="/regiao/sul-e-caparao/">Sul e Caparaó</a> e o{' '}
            <a href="/regiao/litoral-e-franja/">Litoral e a franja
            metropolitana</a>.
          </p>

          <h2>Como trabalho</h2>

          <p>
            Cada imóvel é apresentado com informações objetivas sobre localização,
            características e condições de venda. O acompanhamento próximo ajuda
            a alinhar expectativas e tornar a negociação mais simples.
          </p>

          <p>
            Fora dessas regiões, costumo indicar um profissional local para
            garantir um atendimento adequado.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="secao--compacta sb__fecho-env">
    <div class="env sb__fecho">
      <div>
        <h2 class="sb__h2">Deseja conversar sobre uma propriedade?</h2>
        <p class="lead">
          Estou à disposição pelo WhatsApp.
        </p>
      </div>
      <div class="sb__fecho-acoes">
        <BotaoWhats origem="sobre-fecho" rotulo="Falar no WhatsApp" />
      </div>
    </div>
  </section>
</Base>

<style>
  .sb__cab-env {
    padding-top: var(--s-7);
    border-bottom: var(--borda);
  }

  .sb__topo {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-8);
    align-items: start;
  }

  .sb__retrato {
    display: grid;
    gap: var(--s-6);
    position: sticky;
    top: var(--s-7);
  }

  .sb__moldura {
    border: var(--borda);
    background: var(--marmore);
    padding: var(--s-6);
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    align-content: center;
    aspect-ratio: 4 / 5;
  }

  .sb__moldura :global(.croqui) {
    color: var(--filete);
  }

  .sb__h2 {
    font-size: var(--t-h2);
  }

  .sb__fecho {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-7);
    align-items: center;
  }

  .sb__fecho .lead {
    margin-top: var(--s-3);
  }

  .sb__fecho-acoes {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .sb__topo,
    .sb__fecho {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }

    .sb__retrato {
      position: static;
      max-width: 420px;
    }

    .sb__fecho-acoes {
      justify-content: flex-start;
    }
  }
</style>
