---
import { getCollection } from 'astro:content';

import Base from '../layouts/Base.astro';
import CabecalhoSecao from '../components/CabecalhoSecao.astro';
import FaixaTerritorios from '../components/FaixaTerritorios.astro';
import FaixaTopografica from '../components/FaixaTopografica.astro';
import FichaImovel from '../components/FichaImovel.astro';
import BuscaImoveis from '../components/BuscaImoveis.astro';
import MapaTerritorios from '../components/MapaTerritorios.astro';
import ToggleUnidade from '../components/ToggleUnidade.astro';
import Croqui from '../components/Croqui.astro';

import { corretor, meta } from '../data/site';
import { territorios, CONTORNO_ES, VIEWBOX_ES } from '../data/territorios';
import { dataCurta, areas as fmtAreas } from '../lib/format';
import { formatarArea } from '../lib/unidades';
import { imovelPublicado } from '../lib/publicacao';

const imoveis = (await getCollection('imoveis')).filter(imovelPublicado).sort(
  (a, b) => b.data.atualizadoEm.getTime() - a.data.atualizadoEm.getTime(),
);
/* `naCarteira` = tudo que ainda não foi vendido (inclui reservadas, que
   continuam visíveis com o selo). `ativas` = efetivamente disponíveis.
   Os dois números aparecem no site e precisam significar a mesma coisa em
   todo lugar, ver também o rodapé. */
const naCarteira = imoveis.filter((i) => i.data.status !== 'vendida');
const ativas = imoveis.filter((i) => i.data.status === 'ativa');
const vendidos = imoveis.filter((i) => i.data.status === 'vendida');

/* A vitrine mostra os destaques primeiro, depois o resto, e sempre inclui
   uma vendida no fim. Imóvel vendido é prova social real. */
const vitrine = [
  ...naCarteira.filter((i) => i.data.destaque),
  ...naCarteira.filter((i) => !i.data.destaque),
].slice(0, 5);
const vitrineFinal = [...vitrine, ...vendidos.slice(0, 1)];

/* Números do hero: verdadeiros, vindos do conteúdo, mudam sozinhos. */
const municipios = new Set(naCarteira.map((i) => i.data.municipio)).size;
const listaMunicipios = [...new Set(ativas.map((i) => i.data.municipio))].sort((a, b) =>
  a.localeCompare(b, 'pt-BR'),
);
const areas = naCarteira
  .map((i) => i.data.areaHa)
  .filter((area): area is number => area != null);
const ultimaAtualizacao = imoveis
  .map((i) => i.data.atualizadoEm)
  .sort((a, b) => b.getTime() - a.getTime())[0];

const contagemPorRegiao = Object.fromEntries(
  territorios.map((t) => [t.slug, ativas.filter((i) => i.data.regiao === t.slug).length]),
);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: `${corretor.nome} Imóveis`,
    alternateName: 'Valdecir Francisco Imóveis Rurais',
    url: Astro.site?.href,
    description: meta.descricao,
    publisher: { '@id': `${Astro.site}#corretor` },
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Imóveis rurais em destaque no Espírito Santo',
    numberOfItems: vitrineFinal.length,
    itemListElement: vitrineFinal.map((imovel, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: imovel.data.titulo,
      url: new URL(`/imovel/${imovel.id}/`, Astro.site).href,
    })),
  },
];
---

<Base descricao={meta.descricao} jsonLd={jsonLd}>
  {/* ===================================================== 01 · HERO ===== */}
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="env hero__int">
      <div class="hero__grade">
        <div class="hero__texto">
          <h1 class="display" id="hero-titulo">
            Imóveis rurais à venda no Espírito Santo.
          </h1>
          <p class="lead hero__sub">
            Encontre fazendas, chácaras, sítios e terrenos rurais com fotos reais,
            preço, acesso e informações claras para escolher melhor.
          </p>

          <div class="hero__acoes">
            <a class="botao botao--primario" href="#carteira">Ver imóveis à venda</a>
            <a class="link-seta" href="/quero-vender/">
              Quero vender uma área
              <span class="link-seta__seta" aria-hidden="true">→</span>
            </a>
          </div>

          <ul class="hero__fatos" aria-label="Resumo da carteira">
            <li><strong>{ativas.length}</strong><span>áreas ativas</span></li>
            <li><strong>{municipios}</strong><span>municípios</span></li>
            {
              areas.length > 0 && (
                <li>
                  <strong>{formatarArea(Math.min(...areas))}–{formatarArea(Math.max(...areas))} ha</strong>
                  <span>faixa de áreas</span>
                </li>
              )
            }
          </ul>
        </div>

        <aside class="hero__painel">
          <BuscaImoveis
            municipios={listaMunicipios}
            titulo="Comece por aqui"
            nota={`Escolha o que procura. Carteira atualizada ${ultimaAtualizacao ? `em ${dataCurta(ultimaAtualizacao)}` : 'recentemente'}.`}
            origem="home-hero"
          />
        </aside>
      </div>
    </div>

    <div class="hero__faixa">
      <FaixaTopografica />
    </div>
  </section>

  {/* ============================================ 02 · TERRITÓRIOS ======= */}
  <FaixaTerritorios />

  {/* ================================================= 05 · A CARTEIRA === */}
  <section class="secao" id="carteira" aria-labelledby="carteira-titulo">
    <div class="env">
      <div class="carteira__cab">
        <CabecalhoSecao
          kicker="Imóveis rurais"
          titulo="Fazendas, sítios, chácaras e terrenos disponíveis"
          subtitulo="Atualizo essa lista toda semana. Quando sai, marco como vendida em vez de apagar."
        />
        <ToggleUnidade />
      </div>

      <div class="carteira__grade">
        {vitrineFinal.map((imovel) => <FichaImovel imovel={imovel} />)}
      </div>

      <div class="carteira__rodape">
        <a class="botao botao--secundario" href="/imoveis/">
          Ver todas as {fmtAreas(imoveis.length)}
        </a>
        <p class="peq secundario carteira__nota">
          Boa parte da terra boa sai antes de eu anunciar. Quem está na lista
          recebe primeiro.
        </p>
      </div>
    </div>
  </section>

  {/* ================================================== 06 · AS REGIÕES == */}
  <section class="secao secao--filete" id="regioes" aria-labelledby="regioes-titulo">
    <div class="env">
      <CabecalhoSecao
        kicker="Onde eu ando"
        titulo="Quatro regiões, diferentes oportunidades"
        subtitulo="Cada região tem cultura, relevo, faixa de preço e características próprias. Clique para conhecer."
      />

      <MapaTerritorios contagem={contagemPorRegiao} />

    </div>
  </section>

  {/* ============================================== 07 · QUEM SOU EU ===== */}
  <section class="secao secao--papel2 secao--filete" id="sobre" aria-labelledby="sobre-titulo">
    <div class="env sobre">
      <div class="sobre__retrato">
        {/* Placeholder do retrato: enquanto não há foto autoral, um croqui
            grande sustenta o bloco sem recorrer a banco de imagens. */}
        <div class="sobre__moldura">
          <div class="sobre__croqui">
            <Croqui path={CONTORNO_ES} viewBox={VIEWBOX_ES} tamanho={200} desenhar />
          </div>
        </div>
      </div>

      <div class="sobre__texto">
        <CabecalhoSecao kicker="Atendimento direto" titulo="Compra e venda com atendimento pessoal" as="h2" />

        <div class="prosa sobre__prosa">
          <p>
            Sou {corretor.nome} e atuo com compra e venda de imóveis rurais no Espírito Santo.
          </p>
          <p>
            O atendimento é feito diretamente comigo, desde o primeiro contato
            até a conclusão da negociação. Cada oportunidade é apresentada com
            clareza, respeito e atenção às necessidades de compradores e proprietários.
          </p>
          <p>
            Conheço as regiões atendidas e acompanho cada oportunidade de perto,
            com informações objetivas sobre localização, características e
            condições de venda.
          </p>
        </div>

      </div>
    </div>
  </section>

</Base>

<style>
  /* ---- 01 Hero ---------------------------------------------------------- */
  .hero__int {
    padding-top: clamp(var(--s-7), 7vw, var(--s-9));
    padding-bottom: var(--s-8);
  }

  .hero__grade {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(340px, 4fr);
    gap: clamp(var(--s-7), 6vw, var(--s-9));
    align-items: start;
  }

  .hero h1 {
    max-width: 13ch;
  }

  .hero__sub {
    margin-top: var(--s-6);
    max-width: 42ch;
  }

  .hero__acoes {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-top: var(--s-7);
  }

  .hero__fatos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4) var(--s-6);
    margin-top: var(--s-7);
    padding-top: var(--s-4);
    border-top: var(--borda);
  }

  .hero__fatos li {
    display: grid;
    gap: 1px;
  }

  .hero__fatos strong {
    font-family: var(--f-mono);
    font-size: var(--t-peq);
    font-weight: 600;
  }

  .hero__fatos span {
    color: var(--grafite-70);
    font-size: var(--t-peq);
  }

  .hero__painel {
    /* empurra a ficha para baixo da primeira linha do título, assimetria
       deliberada, não alinhamento automático */
    padding-top: var(--s-6);
    padding-left: var(--s-6);
    border-left: var(--borda);
  }

  .hero__faixa {
    margin-top: var(--s-4);
  }

  @media (max-width: 900px) {
    .hero__grade {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-7);
    }

    .hero__painel {
      padding-top: 0;
      padding-left: 0;
      border-left: 0;
      max-width: 420px;
    }
  }

  /* ---- 05 Carteira ------------------------------------------------------ */
  .carteira__cab {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-6);
    flex-wrap: wrap;
    margin-bottom: var(--s-7);
  }

  .carteira__cab > :global(header) {
    margin-bottom: 0;
  }

  .carteira__grade {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8) var(--gutter);
  }

  .carteira__rodape {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    flex-wrap: wrap;
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: var(--borda);
  }

  .carteira__nota {
    max-width: 40ch;
  }

  /* ---- 07 Sobre --------------------------------------------------------- */
  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--s-8);
    align-items: start;
  }

  .sobre__moldura {
    border-block: var(--borda);
    border-top: var(--borda-2);
    background: transparent;
    padding: var(--s-6);
    display: grid;
    justify-items: center;
    gap: var(--s-5);
    aspect-ratio: 4 / 5;
    align-content: center;
  }

  .sobre__croqui {
    color: var(--filete);
  }

  .sobre__prosa {
    margin-top: calc(var(--s-7) * -1 + var(--s-2));
  }

  @media (max-width: 900px) {
    .carteira__grade {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-7);
    }

    .sobre {
      grid-template-columns: minmax(0, 1fr);
    }

    .sobre__moldura {
      max-width: 320px;
    }

    .sobre__prosa {
      margin-top: 0;
    }
  }

</style>
