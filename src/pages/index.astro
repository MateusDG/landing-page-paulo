---
import { getCollection, render } from 'astro:content';

import Base from '../layouts/Base.astro';
import CabecalhoSecao from '../components/CabecalhoSecao.astro';
import FaixaTerritorios from '../components/FaixaTerritorios.astro';
import FaixaTopografica from '../components/FaixaTopografica.astro';
import FichaImovel from '../components/FichaImovel.astro';
import FichaTecnica from '../components/FichaTecnica.astro';
import ListaNumerada from '../components/ListaNumerada.astro';
import MapaTerritorios from '../components/MapaTerritorios.astro';
import Acordeao from '../components/Acordeao.astro';
import Briefing from '../components/Briefing.astro';
import ToggleUnidade from '../components/ToggleUnidade.astro';
import BotaoWhats from '../components/BotaoWhats.astro';
import CotaDimensional from '../components/CotaDimensional.astro';
import Croqui from '../components/Croqui.astro';

import { corretor, emCampo, coordenadaBase, meta } from '../data/site';
import { protocoloDocumental, protocoloFisico, notaProtocolo } from '../data/protocolo';
import { glossario } from '../data/glossario';
import { deslocamento, notaDeslocamento } from '../data/deslocamento';
import { territorios, CONTORNO_ES, VIEWBOX_ES } from '../data/territorios';
import { dataCurta, numero, areas as fmtAreas } from '../lib/format';
import { formatarArea } from '../lib/unidades';

const imoveis = await getCollection('imoveis');
/* `naCarteira` = tudo que ainda não foi vendido (inclui reservadas, que
   continuam visíveis com o selo). `ativas` = efetivamente disponíveis.
   Os dois números aparecem no site e precisam significar a mesma coisa em
   todo lugar — ver também o rodapé. */
const naCarteira = imoveis.filter((i) => i.data.status !== 'vendida');
const ativas = imoveis.filter((i) => i.data.status === 'ativa');
const vendidos = imoveis.filter((i) => i.data.status === 'vendida');

/* A vitrine mostra os destaques primeiro, depois o resto — e sempre inclui
   uma vendida no fim. Imóvel vendido é prova social real. */
const vitrine = [
  ...naCarteira.filter((i) => i.data.destaque),
  ...naCarteira.filter((i) => !i.data.destaque),
].slice(0, 5);
const vitrineFinal = [...vitrine, ...vendidos.slice(0, 1)];

/* Números do painel do hero: verdadeiros, vindos do conteúdo, mudam sozinhos. */
const municipios = new Set(imoveis.map((i) => i.data.municipio)).size;
const areas = naCarteira.map((i) => i.data.areaHa);
const ultimaAtualizacao = imoveis
  .map((i) => i.data.atualizadoEm)
  .sort((a, b) => b.getTime() - a.getTime())[0];

const painelHero = [
  { rotulo: 'Áreas ativas', valor: String(ativas.length), destaque: true },
  { rotulo: 'Reservadas', valor: String(naCarteira.length - ativas.length) },
  { rotulo: 'Municípios', valor: String(municipios) },
  { rotulo: 'Menor área', valor: `${formatarArea(Math.min(...areas))} ha` },
  { rotulo: 'Maior área', valor: `${formatarArea(Math.max(...areas))} ha` },
  { rotulo: 'Regiões', valor: `${territorios.length} de 4` },
];

const contagemPorRegiao = Object.fromEntries(
  territorios.map((t) => [t.slug, ativas.filter((i) => i.data.regiao === t.slug).length]),
);

const caso = (await getCollection('casos')).find((c) => c.data.destaque);
const CasoConteudo = caso ? (await render(caso)).Content : null;

/* Os seis problemas. Cada um é um caso real que eu já vi travar negócio. */
const problemas = [
  { titulo: 'A área tem 40 ha na conversa e 31,4 ha na matrícula.' },
  {
    titulo:
      'O CAR está inscrito, mas com a reserva legal proposta em cima da melhor parte da lavoura.',
  },
  { titulo: 'A nascente que abastece tudo não tem outorga.' },
  {
    titulo:
      'O acesso passa por dentro do vizinho e não existe servidão registrada na matrícula.',
  },
  { titulo: 'O vendedor tem dívida de ITR de sete exercícios — e ela acompanha o imóvel.' },
  { titulo: 'O georreferenciamento nunca foi feito e a venda trava no cartório.' },
];

const verbetesHome = glossario.filter((v) => v.destaqueNaHome);
const deslocamentoPreview = deslocamento.slice(0, 8);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: corretor.nome,
    url: Astro.site?.href,
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: verbetesHome.map((v) => ({
      '@type': 'Question',
      name: `${v.termo}${v.sigla ? ` (${v.sigla})` : ''}`,
      acceptedAnswer: { '@type': 'Answer', text: `${v.resumo} ${v.porQueImporta}` },
    })),
  },
];
---

<Base descricao={meta.descricao} jsonLd={jsonLd}>
  {/* ===================================================== 01 · HERO ===== */}
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="env hero__int">
      <p class="rotulo rotulo--fraco hero__coord">
        {coordenadaBase.texto} · {coordenadaBase.local}
      </p>

      <div class="hero__grade">
        <div class="hero__texto">
          <h1 class="display" id="hero-titulo">
            Terra no Espírito Santo se compra com a matrícula na mão.
          </h1>
          <p class="lead hero__sub">
            Ando a área, leio o documento e só depois te ligo. Fazendas,
            chácaras, sítios e terrenos rurais nas quatro regiões do estado.
          </p>

          <div class="hero__acoes">
            <a class="botao botao--primario" href="#carteira">Ver o que tenho hoje</a>
            <a class="link-seta" href="#metodo">
              Como eu verifico uma área
              <span class="link-seta__seta" aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <aside class="hero__painel">
          <FichaTecnica
            titulo="Em carteira hoje"
            linhas={painelHero}
            nota={ultimaAtualizacao ? `Atualizado em ${dataCurta(ultimaAtualizacao)}` : undefined}
          />
        </aside>
      </div>
    </div>

    <FaixaTopografica class="hero__faixa" />
  </section>

  {/* ============================================ 02 · TERRITÓRIOS ======= */}
  <FaixaTerritorios />

  {/* =============================================== 03 · O PROBLEMA ===== */}
  <section class="secao" aria-labelledby="problema-titulo">
    <div class="env">
      <div class="bloco-7">
        <CabecalhoSecao
          n={1}
          kicker="O que costuma dar errado"
          titulo="Compra de terra raramente dá errado no preço."
          subtitulo="Dá errado no documento. Estes seis casos eu já vi travarem negócio depois do sinal pago."
        />
        <ListaNumerada itens={problemas} />
        <p class="fecho">
          Nenhum desses problemas aparece na foto do drone. Todos aparecem no
          cartório — e aí você já pagou o sinal.
        </p>
      </div>
    </div>
  </section>

  {/* ================================================== 04 · O MÉTODO ==== */}
  <section class="secao secao--papel2 secao--filete" id="metodo" aria-labelledby="metodo-titulo">
    <div class="env">
      <div class="metodo__cab">
        <CabecalhoSecao
          n={2}
          kicker={`Protocolo de campo · v.${new Date().getFullYear()}`}
          titulo="O que eu checo antes de te mostrar uma área"
          subtitulo="Quatorze pontos. Sete no papel, sete no chão. Se algum não fecha, você fica sabendo antes de gastar um sábado dirigindo."
        />
        <div class="metodo__cota">
          <CotaDimensional valor="14 pontos" orientacao="horizontal" />
        </div>
      </div>

      <div class="metodo__colunas">
        <div>
          <p class="rotulo metodo__grupo">Documental</p>
          <ListaNumerada itens={protocoloDocumental} ritmo="denso" inicio={1} />
        </div>
        <div>
          <p class="rotulo metodo__grupo">Físico</p>
          <ListaNumerada itens={protocoloFisico} ritmo="denso" inicio={8} />
        </div>
      </div>

      <blockquote class="metodo__nota">
        <p>{notaProtocolo}</p>
      </blockquote>

      <div class="metodo__isca">
        <div>
          <p class="rotulo rotulo--terra">Leve o checklist</p>
          <p class="metodo__isca-texto">
            Baixe os 14 pontos em uma página e use com qualquer corretor —
            inclusive comigo.
          </p>
        </div>
        <a
          class="botao botao--escuro"
          href="/checklist-14-pontos.pdf"
          download
          data-evento="checklist_download"
        >
          Baixar o checklist
        </a>
      </div>
    </div>
  </section>

  {/* ================================================= 05 · A CARTEIRA === */}
  <section class="secao" id="carteira" aria-labelledby="carteira-titulo">
    <div class="env">
      <div class="carteira__cab">
        <CabecalhoSecao
          n={3}
          kicker="A carteira"
          titulo="O que eu tenho hoje"
          subtitulo="Atualizo essa lista toda semana. Quando sai, marco como vendida em vez de apagar."
        />
        <ToggleUnidade />
      </div>

      <div class="carteira__grade">
        {vitrineFinal.map((imovel) => <FichaImovel imovel={imovel} />)}
      </div>

      <div class="carteira__rodape">
        <a class="botao botao--secundario" href="/imoveis/">
          Ver todas as {fmtAreas(imoveis.length)}
        </a>
        <p class="peq secundario carteira__nota">
          Boa parte da terra boa sai antes de eu anunciar. Quem está na lista
          recebe primeiro.
        </p>
      </div>
    </div>
  </section>

  {/* ================================================== 06 · AS REGIÕES == */}
  <section class="secao secao--filete" id="regioes" aria-labelledby="regioes-titulo">
    <div class="env">
      <CabecalhoSecao
        n={4}
        kicker="Onde eu ando"
        titulo="Quatro regiões, quatro lógicas de compra"
        subtitulo="Cada uma tem cultura, relevo, faixa de preço e tipo de problema documental próprios. Clique para ver."
      />

      <MapaTerritorios contagem={contagemPorRegiao} />

      {/* Índice de deslocamento — conteúdo que só existe porque foi medido */}
      <div class="desloc">
        <div class="desloc__cab">
          <div>
            <p class="rotulo rotulo--terra">Índice de deslocamento</p>
            <h3 class="desloc__titulo">Quanto tempo você leva de Vitória até lá</h3>
            <p class="desloc__nota">{notaDeslocamento}</p>
          </div>
        </div>

        <div class="desloc__tabela-env">
          <table class="desloc__tabela">
            <caption class="so-leitor">
              Tempo de deslocamento a partir de Vitória, distância, percentual
              de asfalto e observação de campo.
            </caption>
            <thead>
              <tr>
                <th scope="col">Município</th>
                <th scope="col">Tempo</th>
                <th scope="col">Km</th>
                <th scope="col">Asfalto</th>
                <th scope="col">Observação de campo</th>
              </tr>
            </thead>
            <tbody>
              {
                deslocamentoPreview.map((l) => (
                  <tr>
                    <th scope="row">{l.municipio}</th>
                    <td class="mono">{l.tempo}</td>
                    <td class="mono">{numero(l.km)}</td>
                    <td class="mono">{l.asfalto}%</td>
                    <td class="desloc__obs">{l.nota}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        <a class="link-seta" href="/guia/indice-de-deslocamento/">
          Ver os {deslocamento.length} municípios
          <span class="link-seta__seta" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  {/* ============================================== 07 · QUEM SOU EU ===== */}
  <section class="secao secao--papel2 secao--filete" id="sobre" aria-labelledby="sobre-titulo">
    <div class="env sobre">
      <div class="sobre__retrato">
        {/* Placeholder do retrato: enquanto não há foto autoral, um croqui
            grande sustenta o bloco sem recorrer a banco de imagens. */}
        <div class="sobre__moldura">
          <Croqui
            path={CONTORNO_ES}
            viewBox={VIEWBOX_ES}
            tamanho={200}
            desenhar
            class="sobre__croqui"
          />
          <div class="sobre__moldura-legenda">
            <p class="rotulo rotulo--fraco">Espaço reservado</p>
            <p class="peq secundario">
              Aqui entra o retrato em campo — botina suja, não terno em
              estúdio. Ver README §Fotografia.
            </p>
          </div>
        </div>
      </div>

      <div class="sobre__texto">
        <CabecalhoSecao n={5} kicker="Quem fala com você" titulo="Uma pessoa só, do primeiro WhatsApp até a escritura" as="h2" />

        <div class="prosa sobre__prosa">
          <p>
            Sou {corretor.nome}, corretor com CRECI-{corretor.uf} {corretor.creci}.
            Trabalho com imóvel rural desde {corretor.desde} e minha base é
            {' '}{corretor.cidadeBase}.
          </p>
          <p>
            Não sou imobiliária. Sou uma pessoa só — o que significa que você
            fala comigo do primeiro contato até a escritura, e também que eu
            não consigo atender todo mundo ao mesmo tempo. Prefiro assim.
          </p>
          <p>
            Meu trabalho começa antes do anúncio: eu vou até a área, ando o
            perímetro, converso com vizinho, peço a matrícula e puxo o CAR. Se
            não fecha, não anuncio. Já perdi comissão fazendo isso e continuo
            fazendo.
          </p>
        </div>

        <div class="sobre__ficha">
          <FichaTecnica titulo="Em campo" linhas={emCampo} variante="caixa" />
        </div>
      </div>
    </div>
  </section>

  {/* ================================================ 08 · ESTUDO DE CASO */}
  {
    caso && (
      <section class="secao" aria-labelledby="caso-titulo">
        <div class="env">
          <div class="bloco-9">
            <CabecalhoSecao
              n={6}
              kicker={caso.data.referencia}
              titulo="Um caso, contado inteiro"
              subtitulo="Prefiro um caso com números a seis depoimentos de duas linhas."
            />

            <div class="caso">
              <dl class="caso__ficha">
                <div>
                  <dt class="rotulo rotulo--fraco">O comprador</dt>
                  <dd>{caso.data.comprador}</dd>
                </div>
                <div>
                  <dt class="rotulo rotulo--fraco">O que procuravam</dt>
                  <dd>{caso.data.procuravam}</dd>
                </div>
                <div>
                  <dt class="rotulo rotulo--fraco">O que travou</dt>
                  <dd>{caso.data.oQueTravou}</dd>
                </div>
                <div>
                  <dt class="rotulo rotulo--fraco">O que fizemos</dt>
                  <dd>{caso.data.oQueFizemos}</dd>
                </div>
                <div>
                  <dt class="rotulo rotulo--fraco">O resultado</dt>
                  <dd>{caso.data.resultado}</dd>
                </div>
              </dl>

              <div class="caso__lado">
                <FichaTecnica
                  linhas={[
                    { rotulo: 'Município', valor: caso.data.municipio },
                    { rotulo: 'Área', valor: `${formatarArea(caso.data.areaHa)} ha` },
                    { rotulo: 'Fechado em', valor: dataCurta(caso.data.fechadoEm) },
                  ]}
                />

                <blockquote class="caso__depo">
                  <p>{caso.data.depoimento.texto}</p>
                  <footer class="rotulo rotulo--fraco">
                    — {caso.data.depoimento.autor}, {caso.data.depoimento.cidade}
                  </footer>
                </blockquote>
              </div>
            </div>

            {CasoConteudo && (
              <div class="prosa caso__prosa">
                <CasoConteudo />
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  {/* =================================================== 09 · BRIEFING === */}
  <section class="secao secao--filete" id="briefing" aria-labelledby="briefing-titulo">
    <div class="env briefing-secao">
      <div class="briefing-secao__texto">
        <CabecalhoSecao
          n={7}
          kicker="Conversa"
          titulo="Me diga o que você procura em cinco cliques"
          subtitulo="Sem formulário longo, sem e-mail obrigatório. No fim abre o WhatsApp com o seu briefing já escrito."
        />

        <ul class="briefing-secao__lista">
          <li>Você responde clicando — digita só nome e telefone, no fim.</li>
          <li>Eu recebo o resumo estruturado, com região, área e prazo.</li>
          <li>{corretor.sla}</li>
        </ul>

        <div class="briefing-secao__alt">
          <p class="rotulo rotulo--fraco">Prefere ir direto?</p>
          <BotaoWhats origem="briefing-secao" variante="secundario" rotulo="Falar no WhatsApp agora" />
        </div>
      </div>

      <div class="briefing-secao__form">
        <Briefing origem="home" />
      </div>
    </div>
  </section>

  {/* =================================================== 10 · GLOSSÁRIO == */}
  <section class="secao secao--papel2 secao--filete" id="duvidas" aria-labelledby="duvidas-titulo">
    <div class="env">
      <div class="bloco-9">
        <CabecalhoSecao
          n={8}
          kicker="Dúvidas de quem nunca comprou terra"
          titulo="Os termos que aparecem na hora errada"
          subtitulo="São os oito que mais travam conversa. O glossário completo tem doze."
        />

        <Acordeao
          itens={verbetesHome.map((v) => ({
            pergunta: v.sigla ? `${v.termo} (${v.sigla})` : v.termo,
            resposta: `${v.resumo} ${v.porQueImporta}`,
          }))}
        />

        <div class="glossario__rodape">
          <a class="link-seta" href="/guia/glossario-do-comprador-rural/">
            Ver o glossário completo
            <span class="link-seta__seta" aria-hidden="true">→</span>
          </a>
          <a class="link-seta" href="/guia/">
            Todos os guias
            <span class="link-seta__seta" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Composição -------------------------------------------------------
     Nenhum bloco usa as 12 colunas. As larguras alternam de propósito — é o
     que faz a página parecer desenhada em vez de gerada. */
  .bloco-7 {
    max-width: 62ch;
  }

  .bloco-9 {
    max-width: 82ch;
  }

  /* ---- 01 Hero ---------------------------------------------------------- */
  .hero__int {
    padding-top: clamp(var(--s-7), 7vw, var(--s-9));
    padding-bottom: var(--s-8);
  }

  .hero__coord {
    padding-bottom: var(--s-6);
  }

  .hero__grade {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--s-8);
    align-items: start;
  }

  .hero h1 {
    max-width: 13ch;
  }

  .hero__sub {
    margin-top: var(--s-6);
    max-width: 42ch;
  }

  .hero__acoes {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-top: var(--s-7);
  }

  .hero__painel {
    /* empurra a ficha para baixo da primeira linha do título — assimetria
       deliberada, não alinhamento automático */
    padding-top: var(--s-6);
  }

  .hero__faixa {
    margin-top: var(--s-4);
  }

  @media (max-width: 900px) {
    .hero__grade {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-7);
    }

    .hero__painel {
      padding-top: 0;
      max-width: 420px;
    }
  }

  /* ---- 03 Problema ------------------------------------------------------ */
  .fecho {
    margin-top: var(--s-6);
    font-family: var(--f-display);
    font-size: var(--t-h3);
    line-height: 1.45;
    max-width: 44ch;
  }

  /* ---- 04 Método -------------------------------------------------------- */
  .metodo__cab {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 3fr);
    gap: var(--s-7);
    align-items: end;
  }

  .metodo__cota {
    padding-bottom: var(--s-8);
  }

  .metodo__colunas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-8);
  }

  .metodo__grupo {
    color: var(--grafite);
    padding-bottom: var(--s-3);
    border-bottom: 1px solid var(--grafite);
  }

  .metodo__nota {
    margin-top: var(--s-7);
    padding-left: var(--s-5);
    border-left: var(--borda-2);
    font-family: var(--f-display);
    font-size: var(--t-lead);
    line-height: 1.5;
    max-width: 56ch;
  }

  .metodo__isca {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    flex-wrap: wrap;
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: var(--borda);
  }

  .metodo__isca-texto {
    margin-top: var(--s-2);
    max-width: 44ch;
  }

  @media (max-width: 900px) {
    .metodo__cab,
    .metodo__colunas {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }

    .metodo__cota {
      display: none;
    }
  }

  /* ---- 05 Carteira ------------------------------------------------------ */
  .carteira__cab {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-6);
    flex-wrap: wrap;
    margin-bottom: var(--s-7);
  }

  .carteira__cab > :global(header) {
    margin-bottom: 0;
  }

  .carteira__grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
    gap: var(--gutter);
  }

  .carteira__rodape {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    flex-wrap: wrap;
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: var(--borda);
  }

  .carteira__nota {
    max-width: 40ch;
  }

  /* ---- 06 Regiões ------------------------------------------------------- */
  .desloc {
    margin-top: var(--s-9);
    padding-top: var(--s-7);
    border-top: var(--borda);
  }

  .desloc__titulo {
    margin-top: var(--s-3);
    font-size: var(--t-h2);
    font-weight: 400;
    max-width: 20ch;
  }

  .desloc__nota {
