---
import { getCollection, render } from 'astro:content';
import Editorial from '../../layouts/Editorial.astro';
import Acordeao from '../../components/Acordeao.astro';
import { dataCurta, iso } from '../../lib/format';
import { corretor } from '../../data/site';

export async function getStaticPaths() {
  const guias = await getCollection('guias');
  return guias.map((guia) => ({ params: { slug: guia.id }, props: { guia } }));
}

const { guia } = Astro.props;
const g = guia.data;
const { Content } = await render(guia);

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: g.tituloSeo ?? g.titulo,
    description: g.descricao,
    inLanguage: 'pt-BR',
    datePublished: iso(g.publicadoEm),
    dateModified: iso(g.atualizadoEm),
    author: { '@type': 'Person', name: corretor.nome },
    publisher: { '@type': 'Person', name: corretor.nome },
  },
];

if (g.perguntas.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: g.perguntas.map((p) => ({
      '@type': 'Question',
      name: p.pergunta,
      acceptedAnswer: { '@type': 'Answer', text: p.resposta },
    })),
  });
}

const meta = [
  { rotulo: 'Publicado', valor: dataCurta(g.publicadoEm) },
  { rotulo: 'Atualizado', valor: dataCurta(g.atualizadoEm) },
  {
    rotulo: 'Revisão jurídica',
    valor: g.revisadoPorAdvogado ? 'Sim' : 'Pendente',
  },
];
---

<Editorial
  titulo={g.titulo}
  tituloSeo={g.tituloSeo}
  descricao={g.descricao}
  kicker="Guia"
  meta={meta}
  trilha={[{ rotulo: 'Guias', href: '/guia/' }]}
  jsonLd={jsonLd}
  aviso="Conteúdo informativo, escrito para orientar a conversa. Não substitui consulta a advogado, engenheiro agrônomo, cartório e órgãos competentes. Regras e prazos mudam, confirme a norma vigente."
>
  <Content />

  {
    g.perguntas.length > 0 && (
      <section class="gu__faq">
        <h2>Perguntas que sempre aparecem</h2>
        <Acordeao itens={g.perguntas.map((p) => ({ pergunta: p.pergunta, resposta: p.resposta }))} />
      </section>
    )
  }
</Editorial>

<style>
  .gu__faq {
    margin-top: var(--s-8);
  }

  .gu__faq h2 {
    margin-bottom: var(--s-5);
  }
</style>
