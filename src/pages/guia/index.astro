---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CabecalhoSecao from '../../components/CabecalhoSecao.astro';
import { dataCurta } from '../../lib/format';
import { deslocamento } from '../../data/deslocamento';
import { glossario } from '../../data/glossario';

const guias = (await getCollection('guias')).sort((a, b) => a.data.ordem - b.data.ordem);

/* Duas páginas do hub são geradas por dados, não por markdown, entram na
   lista à mão para o índice ficar completo. */
const extras = [
  {
    href: '/guia/glossario-do-comprador-rural/',
    titulo: 'Glossário do comprador rural',
    resumo: `Os ${glossario.length} termos que aparecem na hora errada, com o que cada um significa na prática.`,
  },
  {
    href: '/guia/indice-de-deslocamento/',
    titulo: 'Índice de deslocamento',
    resumo: `Tempo real de Vitória até ${deslocamento.length} municípios, medido por mim, com condição de estrada.`,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Guias do comprador de imóvel rural no Espírito Santo',
  inLanguage: 'pt-BR',
};
---

<Base
  titulo="Guias, comprar imóvel rural no Espírito Santo"
  descricao="Documentos, água e outorga, custo de manutenção, glossário e o índice de deslocamento. O que eu explicaria numa conversa, escrito."
  jsonLd={jsonLd}
>
  <section class="secao--compacta gh__cab-env">
    <div class="env">
      <CabecalhoSecao
        kicker="Guias"
        titulo="O que eu explicaria numa conversa, escrito"
        subtitulo="Nada aqui é conteúdo para preencher página. São as dúvidas que aparecem toda semana, na ordem em que aparecem."
        as="h1"
      />
    </div>
  </section>

  <section class="secao--compacta">
    <div class="env">
      <ol class="gh__lista">
        {
          guias.map((g, i) => (
            <li class="gh__item">
              <span class="mono gh__n">{String(i + 1).padStart(2, '0')}</span>
              <div class="gh__corpo">
                <h2 class="gh__titulo">
                  <a href={`/guia/${g.id}/`}>{g.data.titulo}</a>
                </h2>
                <p class="gh__resumo">{g.data.resumo}</p>
                <p class="rotulo rotulo--fraco">
                  Atualizado em {dataCurta(g.data.atualizadoEm)}
                </p>
              </div>
            </li>
          ))
        }
        {
          extras.map((e, i) => (
            <li class="gh__item">
              <span class="mono gh__n">{String(guias.length + i + 1).padStart(2, '0')}</span>
              <div class="gh__corpo">
                <h2 class="gh__titulo">
                  <a href={e.href}>{e.titulo}</a>
                </h2>
                <p class="gh__resumo">{e.resumo}</p>
                <p class="rotulo rotulo--fraco">Referência</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .gh__cab-env {
    padding-top: var(--s-7);
    border-bottom: var(--borda);
  }

  .gh__lista {
    border-top: var(--borda);
    max-width: 72ch;
  }

  .gh__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: var(--s-5);
    padding-block: var(--s-6);
    border-bottom: var(--borda-f);
    align-items: start;
  }

  .gh__n {
    font-size: var(--t-micro);
    color: var(--terra);
    letter-spacing: var(--tracking-rotulo);
    padding-top: 0.55em;
  }

  .gh__corpo {
    display: grid;
    gap: var(--s-3);
  }

  .gh__titulo {
    font-size: var(--t-h3);
    font-weight: 500;
  }

  .gh__titulo a {
    text-decoration: none;
    transition: color var(--dur-rapida) var(--ease);
  }

  .gh__titulo a:hover {
    color: var(--terra);
  }

  .gh__resumo {
    font-size: var(--t-peq);
    color: var(--grafite-70);
    max-width: 54ch;
  }
</style>
