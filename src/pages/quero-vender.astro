---
import Base from '../layouts/Base.astro';
import CabecalhoSecao from '../components/CabecalhoSecao.astro';
import BotaoWhats from '../components/BotaoWhats.astro';
import FichaTecnica from '../components/FichaTecnica.astro';
import { territorios } from '../data/territorios';

const oQueEuPreciso = [
  { rotulo: 'Localização', valor: 'município da área' },
  { rotulo: 'Tamanho', valor: 'medida aproximada' },
  { rotulo: 'Tipo de imóvel', valor: 'fazenda, sítio, chácara ou terreno' },
  { rotulo: 'Características', valor: 'principais informações da área' },
  { rotulo: 'Contato', valor: 'nome e telefone do proprietário' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${Astro.site}quero-vender/#servico`,
  url: new URL('/quero-vender/', Astro.site).href,
  name: 'Venda de imóvel rural no Espírito Santo',
  description: 'Atendimento a proprietários que desejam vender fazendas, sítios, chácaras ou terrenos rurais no Espírito Santo.',
  serviceType: 'Compra e venda de imóvel rural',
  areaServed: { '@type': 'State', name: 'Espírito Santo' },
  provider: { '@id': `${Astro.site}#corretor` },
  inLanguage: 'pt-BR',
};
---

<Base
  titulo="Venda de imóvel rural no Espírito Santo"
  descricao="Atendimento a proprietários que desejam vender fazendas, chácaras, sítios ou terrenos rurais no Espírito Santo."
  jsonLd={jsonLd}
>
  <section class="secao--compacta qv__cab-env">
    <div class="env qv__topo">
      <div>
        <CabecalhoSecao
          kicker="Venda de imóvel rural"
          titulo="Quero vender minha área"
          subtitulo="Apresente as informações da sua propriedade para iniciar o atendimento de venda no Espírito Santo."
          as="h1"
      />

        <div class="qv__acoes">
          <BotaoWhats
            origem="quero-vender-topo"
            mensagem="Olá, tenho uma área para vender no Espírito Santo."
            rotulo="Apresentar minha área"
          />
        </div>
      </div>

      <aside class="qv__lateral">
        <FichaTecnica
          titulo="Informações iniciais"
          linhas={oQueEuPreciso}
          nota="Envie apenas as informações disponíveis. Os demais dados podem ser complementados durante o atendimento."
        />
      </aside>
    </div>
  </section>

  <section class="secao--compacta qv__onde-env" aria-labelledby="onde-titulo">
    <div class="env">
      <h2 class="qv__h2" id="onde-titulo">Regiões de atuação</h2>
      <div class="qv__regioes">
        {
          territorios.map((t) => (
            <a class="qv__regiao" href={`/regiao/${t.slug}/`}>
              <span class="rotulo qv__regiao-nome">{t.nome}</span>
              <span class="peq secundario">{t.municipios.slice(0, 4).join(' · ')}</span>
            </a>
          ))
        }
      </div>
      <p class="peq secundario qv__onde-nota">
        Para propriedades localizadas fora dessas regiões, a possibilidade de
        atendimento será avaliada conforme a localização.
      </p>
    </div>
  </section>

  <section class="secao--compacta qv__fecho-env">
    <div class="env qv__fecho">
      <div>
        <h2 class="qv__h2">Deseja apresentar sua área?</h2>
        <p class="lead">Envie as informações disponíveis pelo WhatsApp.</p>
      </div>
      <BotaoWhats
        origem="quero-vender-fecho"
        mensagem="Olá, tenho uma área para vender no Espírito Santo. Seguem as informações disponíveis:"
        rotulo="Falar sobre a minha área"
      />
    </div>
  </section>
</Base>

<style>
  .qv__cab-env {
    padding-top: var(--s-7);
    border-bottom: var(--borda);
  }

  .qv__topo {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--s-8);
    align-items: start;
  }

  .qv__acoes {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    flex-wrap: wrap;
  }

  .qv__h2 {
    font-size: var(--t-h2);
    margin-bottom: var(--s-5);
  }

  .qv__onde-env {
    border-block: var(--borda);
    background: var(--papel-2);
  }

  .qv__regioes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--gutter);
  }

  .qv__regiao {
    display: grid;
    gap: var(--s-2);
    border: var(--borda);
    background: var(--papel);
    padding: var(--s-5);
    text-decoration: none;
    transition:
      border-color var(--dur-rapida) var(--ease),
      background-color var(--dur-rapida) var(--ease);
  }

  .qv__regiao:hover {
    border-color: var(--grafite);
    background: var(--marmore);
  }

  .qv__regiao-nome {
    color: var(--grafite);
  }

  .qv__onde-nota {
    margin-top: var(--s-5);
    max-width: 52ch;
  }

  .qv__fecho {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-7);
    align-items: center;
  }

  .qv__fecho .lead {
    margin-top: var(--s-3);
  }

  @media (max-width: 900px) {
    .qv__topo,
    .qv__fecho {
      grid-template-columns: minmax(0, 1fr);
    }

    .qv__lateral {
      max-width: 420px;
    }
  }
</style>
