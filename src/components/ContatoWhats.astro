---
import { linkWhats, numeroWhatsVisivel } from '../lib/whatsapp';

interface Props {
  origem?: string;
  mensagem?: string;
  class?: string;
}

const {
  origem = 'contato',
  mensagem,
  class: classe = '',
} = Astro.props;
---

<a
  class:list={['contato-whats', classe]}
  href={linkWhats({ origem, mensagem })}
  target="_blank"
  rel="noopener"
  aria-label={`Falar no WhatsApp pelo número ${numeroWhatsVisivel}`}
>
  <span class="contato-whats__icone" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z" />
      <path d="M8.2 8.1c.35 3.45 2.25 5.35 5.7 5.7" />
      <path d="m8.2 8.1 1.45-.35.75 2.15-1.05.9" />
      <path d="m13.9 13.8.35-1.45-2.15-.75-.9 1.05" />
    </svg>
  </span>

  <span class="contato-whats__texto">
    <span class="rotulo contato-whats__nome">WhatsApp</span>
    <strong class="contato-whats__numero">{numeroWhatsVisivel}</strong>
  </span>

  <span class="contato-whats__seta" aria-hidden="true">↗</span>
</a>

<style>
  .contato-whats {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s-4);
    width: min(100%, 22rem);
    padding: var(--s-4);
    color: var(--grafite);
    background: var(--papel-2);
    border: var(--borda);
    text-decoration: none;
    transition:
      color var(--dur-rapida) var(--ease),
      border-color var(--dur-rapida) var(--ease),
      background-color var(--dur-rapida) var(--ease);
  }

  .contato-whats:hover,
  .contato-whats:focus-visible {
    color: var(--terra);
    border-color: var(--terra);
    background: var(--marmore);
  }

  .contato-whats__icone {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--papel);
    background: var(--terra);
    border-radius: 50%;
  }

  .contato-whats__icone svg {
    width: 1.45rem;
    height: 1.45rem;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .contato-whats__texto {
    display: grid;
    gap: 0.2rem;
  }

  .contato-whats__nome {
    color: currentColor;
  }

  .contato-whats__numero {
    font-family: var(--f-mono);
    font-size: var(--t-peq);
    font-weight: 500;
    letter-spacing: 0.015em;
  }

  .contato-whats__seta {
    font-size: 1.25rem;
    transition: transform var(--dur-rapida) var(--ease);
  }

  .contato-whats:hover .contato-whats__seta {
    transform: translate(2px, -2px);
  }
</style>
