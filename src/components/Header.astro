---
/**
 * HEADER
 *
 * Não é fixo no desktop: header fixo rouba altura e é assinatura de template.
 * Ele reaparece ao rolar para CIMA (comportamento útil, não decorativo) e
 * some ao descer. Sem JS, fica simplesmente no topo da página.
 *
 * No celular, a navegação principal fica na barra fixa inferior.
 */
import { corretor, navPrincipal } from '../data/site';
import BotaoWhats from './BotaoWhats.astro';

const caminho = Astro.url.pathname;
/* Só marca como página atual quem tem caminho próprio. Âncoras da home
   ("/#regioes") não são páginas e não devem receber aria-current. */
const ativo = (href: string) => {
  const base = href.split('#')[0];
  return base.length > 1 && caminho.startsWith(base);
};
---

<header class="cab" data-cabecalho>
  <div class="env cab__int">
    <a class="cab__marca" href="/">
      <picture class="cab__logo-quadro">
        <source
          type="image/webp"
          srcset="/logo-160.webp 1x, /logo-320.webp 2x"
        />
        <img
          class="cab__logo"
          src="/logo-1200.png"
          alt=""
          width="1200"
          height="1200"
        />
      </picture>
      <span class="cab__marca-texto">
        <strong>{corretor.nome}</strong>
        <span>{corretor.papel} · ES</span>
      </span>
    </a>

    <nav class="cab__nav" aria-label="Navegação principal">
      <ul class="cab__lista">
        {
          navPrincipal.map((item) => (
            <li>
              <a
                class="cab__link"
                href={item.href}
                aria-current={ativo(item.href) ? 'page' : undefined}
              >
                {item.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="cab__cta">
      <BotaoWhats origem="header" variante="secundario" rotulo="Falar comigo" />
    </div>
  </div>
</header>

<style>
  .cab {
    position: relative;
    z-index: var(--z-header);
    border-bottom: var(--borda);
    background: color-mix(in srgb, var(--papel) 94%, transparent);
    backdrop-filter: blur(10px);
  }

  .cab__int {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
    min-height: 72px;
    padding-block: var(--s-2);
  }

  .cab__marca {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    text-decoration: none;
    flex: none;
  }

  .cab__logo-quadro {
    display: block;
    flex: none;
    width: 50px;
    height: 50px;
    overflow: hidden;
    background: transparent;
  }

  .cab__logo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
  }

  .cab__marca-texto {
    display: grid;
    gap: 1px;
    line-height: 1.2;
  }

  .cab__marca-texto strong {
    font-family: var(--f-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .cab__marca-texto span {
    color: var(--grafite-70);
    font-family: var(--f-mono);
    font-size: 0.67rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .cab__lista {
    display: flex;
    gap: var(--s-6);
    align-items: center;
  }

  .cab__link {
    display: inline-block;
    padding-block: var(--s-2);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--grafite-70);
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-rapida) var(--ease),
      border-color var(--dur-rapida) var(--ease);
  }

  .cab__link:hover,
  .cab__link[aria-current='page'] {
    color: var(--grafite);
    border-bottom-color: var(--terra);
  }

  .cab__cta :global(.botao) {
    min-height: 44px;
    padding-inline: var(--s-4);
    border-color: transparent;
    background: transparent;
  }

  .cab__cta :global(.botao:hover) {
    border-color: var(--filete);
  }

  /* Revelação ao rolar para cima. Só existe com JS. */
  :global(.js) .cab {
    position: sticky;
    top: 0;
    transition: transform var(--dur-media) var(--ease);
  }

  :global(.js) .cab[data-oculto='true'] {
    transform: translateY(-100%);
  }

  /* No mobile a navegação vive na barra inferior fixa. */
  @media (max-width: 900px) {
    .cab__nav,
    .cab__cta {
      display: none;
    }

    .cab__int {
      min-height: 64px;
      padding-block: var(--s-2);
    }

    .cab__logo-quadro {
      width: 46px;
      height: 46px;
    }

    .cab__marca-texto span {
      display: none;
    }

    :global(.js) .cab {
      position: static;
    }
  }
</style>

<script>
  const cab = document.querySelector<HTMLElement>('[data-cabecalho]');
  if (cab && window.matchMedia('(min-width: 901px)').matches) {
    let ultimo = window.scrollY;
    let travado = false;

    const aoRolar = () => {
      const y = window.scrollY;
      // Só esconde depois de passar da altura do próprio header.
      const descendo = y > ultimo && y > cab.offsetHeight * 1.5;
      cab.dataset.oculto = String(descendo);
      ultimo = y;
      travado = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!travado) {
          travado = true;
          requestAnimationFrame(aoRolar);
        }
      },
      { passive: true },
    );

    // Teclado nunca deve perder o header: se algo dentro dele receber foco,
    // ele volta.
    cab.addEventListener('focusin', () => {
      cab.dataset.oculto = 'false';
    });
  }
</script>
