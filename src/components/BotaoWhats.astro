---
/**
 * BOTÃO DE WHATSAPP
 *
 * Regra absoluta do projeto: nenhum link sai sem contexto. O corretor precisa
 * saber, em cada mensagem, de qual imóvel e de qual seção da página o lead
 * veio. Isso vale mais que qualquer dashboard.
 */
import { linkWhats, type ContextoWhats } from '../lib/whatsapp';

interface Props extends ContextoWhats {
  rotulo?: string;
  variante?: 'primario' | 'secundario' | 'escuro';
  class?: string;
  /** Nome do evento de analytics. */
  evento?: string;
}

const {
  rotulo = 'Falar no WhatsApp',
  variante = 'primario',
  class: classe = '',
  evento = 'whats_clique',
  ...ctx
} = Astro.props;

const href = linkWhats(ctx);
---

<a
  class:list={['botao', `botao--${variante}`, classe]}
  href={href}
  target="_blank"
  rel="noopener"
  data-evento={evento}
  data-conversao="whats_clique"
  data-tipo="whatsapp"
  data-origem={ctx.origem}
  data-imovel={ctx.imovel}
  data-titulo={ctx.titulo}
  data-intencao={ctx.intencao}
>
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path
      d="M8 1.5a6.5 6.5 0 0 0-5.6 9.8L1.5 14.5l3.3-.9A6.5 6.5 0 1 0 8 1.5Z"
      stroke="currentColor"
      stroke-width="1.3"
      stroke-linejoin="round"
    ></path>
    <path
      d="M5.6 5.2c.3-.1.6 0 .8.3l.5.9c.1.3.1.5-.1.7l-.3.3c-.1.2-.1.3 0 .5.4.7.9 1.2 1.6 1.6.2.1.4.1.5-.1l.3-.3c.2-.2.4-.2.7-.1l.9.5c.3.2.4.5.3.8-.2.6-.8 1-1.4.9-2-.3-3.6-1.9-3.9-3.9-.1-.6.3-1.2.9-1.4Z"
      fill="currentColor"></path>
  </svg>
  {rotulo}
</a>
