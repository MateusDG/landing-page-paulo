---
/**
 * BRIEFING — a conversão principal do site.
 *
 * Progressive enhancement de verdade, não de fachada:
 *
 *   SEM JavaScript → é um <form> normal, com os cinco fieldsets visíveis de
 *   uma vez e um <textarea> extra. O `action` aponta para o wa.me e o
 *   `method="get"` transforma o textarea no parâmetro `text` — ou seja, o
 *   visitante sem JS conclui o contato de verdade, não vê uma mensagem de
 *   erro.
 *
 *   COM JavaScript → o mesmo markup vira cinco passos, uma pergunta por tela,
 *   com progresso em cota dimensional. No envio: POST opcional para o webhook
 *   do CRM e abertura do WhatsApp com a mensagem estruturada.
 *
 * Nenhum campo de e-mail obrigatório: no Brasil rural o canal é o WhatsApp.
 */
import { PUBLIC_LEAD_WEBHOOK } from 'astro:env/client';
import { passos } from '../data/briefing';
import { baseWhats } from '../lib/whatsapp';
import { corretor } from '../data/site';
import CotaDimensional from './CotaDimensional.astro';

interface Props {
  /** Aparece no passo final e na ref da mensagem. */
  origem?: string;
}

const { origem = 'briefing-home' } = Astro.props;
const webhook = PUBLIC_LEAD_WEBHOOK;
---

<div class="bf" data-briefing data-origem={origem} data-webhook={webhook}>
  <form class="bf__form" action={baseWhats} method="get" data-form novalidate>
    <div class="bf__cabecalho">
      <p class="rotulo rotulo--terra" data-progresso-rotulo>Briefing</p>
      <CotaDimensional valor="1 / 5" class="bf__cota" />
    </div>

    {
      passos.map((passo, i) => (
        <fieldset class="bf__passo" data-passo={passo.id} data-indice={i}>
          <legend class="bf__pergunta">
            <span class="rotulo rotulo--fraco bf__n">
              Passo {passo.numero} de {passos.length}
            </span>
            <span class="bf__texto">{passo.pergunta}</span>
          </legend>

          {passo.nota && <p class="bf__nota">{passo.nota}</p>}

          {passo.opcoes && (
            <div class="bf__opcoes" data-multipla={passo.tipo === 'multipla' ? 'sim' : 'nao'}>
              {passo.opcoes.map((o) => (
                <label class="bf__opcao">
                  <input
                    type={passo.tipo === 'multipla' ? 'checkbox' : 'radio'}
                    name={passo.id}
                    value={o.valor}
                    class="bf__input so-leitor"
                  />
                  <span class="bf__opcao-corpo">
                    <span class="bf__opcao-marca" aria-hidden="true" />
                    <span class="bf__opcao-texto">
                      <span class="bf__opcao-rotulo">{o.rotulo}</span>
                      {o.detalhe && <span class="bf__opcao-detalhe">{o.detalhe}</span>}
                    </span>
                  </span>
                </label>
              ))}
            </div>
          )}

          {passo.tipo === 'contato' && (
            <div class="bf__contato">
              <p class="bf__campo">
                <label class="rotulo" for="bf-nome">
                  Como te chamo?
                </label>
                <input
                  id="bf-nome"
                  name="nome"
                  type="text"
                  autocomplete="given-name"
                  required
                  class="bf__texto-input"
                />
              </p>
              <p class="bf__campo">
                <label class="rotulo" for="bf-whats">
                  Seu WhatsApp
                </label>
                <input
                  id="bf-whats"
                  name="telefone"
                  type="tel"
                  inputmode="tel"
                  autocomplete="tel"
                  placeholder="(27) 99999-9999"
                  required
                  class="bf__texto-input"
                />
              </p>

              <label class="bf__consentimento">
                <input type="checkbox" name="consentimento" value="sim" required />
                <span>
                  Autorizo o contato por WhatsApp sobre áreas que batem com o
                  que descrevi. Não recebo mensagem sobre outra coisa. Ver a{' '}
                  <a href="/privacidade/">política de privacidade</a>.
                </span>
              </label>
            </div>
          )}
        </fieldset>
      ))
    }

    {/* Só existe sem JavaScript: transforma o form num contato que funciona. */}
    <noscript>
      <p class="bf__campo">
        <label class="rotulo" for="bf-resumo">
          Resuma em uma linha o que você procura
        </label>
        <textarea id="bf-resumo" name="text" rows="4" class="bf__texto-input"
        ></textarea>
      </p>
      <p class="bf__nota">
        Ao enviar, abre o WhatsApp com a sua mensagem. {corretor.sla}
      </p>
    </noscript>

    <div class="bf__acoes">
      <button type="button" class="botao botao--secundario" data-voltar hidden>
        Voltar
      </button>
      <button type="button" class="botao botao--primario" data-avancar hidden>
        Continuar
      </button>
      <button type="submit" class="botao botao--primario" data-enviar>
        Enviar meu briefing
      </button>
    </div>

    <p class="bf__erro" data-erro role="alert" hidden></p>
  </form>

  {/* Tela de sucesso. Sem JS nunca aparece — e sem JS ela não é necessária. */}
  <div class="bf__sucesso" data-sucesso hidden>
    <p class="rotulo rotulo--terra">Recebido</p>
    <h3 class="bf__sucesso-titulo">Abri o WhatsApp com o seu briefing escrito.</h3>
    <p class="bf__nota">
      Se não abriu — bloqueador de pop-up costuma ser o motivo — use o botão
      abaixo. {corretor.sla}
    </p>
    <p class="mono bf__ref" data-ref></p>
    <a class="botao botao--primario" data-link-whats href={baseWhats} target="_blank" rel="noopener">
      Abrir o WhatsApp
    </a>
  </div>
</div>

<style>
  .bf {
    border: var(--borda-2);
    background: var(--marmore);
    padding: clamp(var(--s-5), 4vw, var(--s-8));
  }

  .bf__cabecalho {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    padding-bottom: var(--s-5);
    border-bottom: var(--borda);
    margin-bottom: var(--s-7);
  }

  .bf__cota {
    flex: 1;
    max-width: 220px;
  }

  .bf__passo {
    border: none;
    padding: 0;
    margin: 0 0 var(--s-8);
  }

  .bf__pergunta {
    display: grid;
    gap: var(--s-3);
    padding: 0;
    margin-bottom: var(--s-5);
  }

  .bf__texto {
    font-family: var(--f-display);
    font-size: var(--t-h2);
    font-weight: 400;
    line-height: var(--lh-titulo);
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  /* A pergunta recebe foco programático a cada passo para que o leitor de
     tela a anuncie antes das opções. Como ela não é focável por Tab, o anel
     de foco aqui só confundiria — parece caixa de erro. */
  .bf__texto:focus {
    outline: none;
  }

  .bf__nota {
    font-size: var(--t-peq);
    line-height: 1.55;
    color: var(--grafite-70);
    max-width: 48ch;
    margin-bottom: var(--s-5);
  }

  .bf__opcoes {
    display: grid;
    border-top: var(--borda);
  }

  .bf__opcao {
    display: block;
    border-bottom: var(--borda-f);
    cursor: pointer;
    transition: background-color var(--dur-rapida) var(--ease);
  }

  .bf__opcao:hover {
    background: var(--papel-2);
  }

  .bf__opcao-corpo {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
    padding: var(--s-4) var(--s-3);
    min-height: 56px;
  }

  .bf__opcao-texto {
    display: block;
  }

  /* Marcador desenhado: quadrado que ganha um quadrado dentro. Sem radio
     nativo estilizado, sem ícone de biblioteca. */
  .bf__opcao-marca {
    width: 14px;
    height: 14px;
    border: 1px solid var(--grafite-40);
    transform: translateY(0.28em);
    transition:
      border-color var(--dur-rapida) var(--ease),
      box-shadow var(--dur-rapida) var(--ease);
  }

  .bf__input:checked + .bf__opcao-corpo .bf__opcao-marca {
    border-color: var(--terra);
    /* o "preenchimento" é um inset — sem box-shadow difuso no sistema */
    box-shadow: inset 0 0 0 3px var(--terra);
  }

  .bf__input:focus-visible + .bf__opcao-corpo {
    outline: 2px solid var(--foco);
    outline-offset: -2px;
  }

  .bf__opcao-rotulo {
    font-size: var(--t-corpo);
    font-weight: 500;
  }

  .bf__opcao-detalhe {
    display: block;
    font-size: var(--t-peq);
    color: var(--grafite-70);
    margin-top: 2px;
  }

  .bf__input:checked + .bf__opcao-corpo .bf__opcao-rotulo {
    color: var(--terra);
  }

  .bf__contato {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-6);
    padding-top: var(--s-6);
    border-top: var(--borda);
  }

  .bf__campo {
    display: grid;
    gap: var(--s-2);
  }

  .bf__texto-input {
    border: var(--borda);
    background: var(--papel);
    padding: var(--s-3) var(--s-4);
    min-height: 48px;
    border-radius: var(--raio-sm);
    font-size: var(--t-corpo);
    width: 100%;
  }

  .bf__texto-input:focus-visible {
    border-color: var(--terra);
  }

  .bf__consentimento {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--s-3);
    align-items: start;
    font-size: var(--t-peq);
    line-height: 1.55;
    color: var(--grafite-70);
    max-width: 56ch;
    cursor: pointer;
  }

  .bf__consentimento input {
    width: 18px;
    height: 18px;
    margin-top: 3px;
    accent-color: var(--terra);
  }

  .bf__acoes {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
    padding-top: var(--s-6);
    border-top: var(--borda);
  }

  .bf__erro {
    margin-top: var(--s-4);
    color: var(--erro);
    font-size: var(--t-peq);
  }

  .bf__sucesso {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  .bf__sucesso-titulo {
    font-size: var(--t-h2);
    font-weight: 400;
    max-width: 24ch;
  }

  .bf__ref {
    font-size: var(--t-micro);
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
    color: var(--grafite-40);
  }

  /* --- Modo passo a passo: só quando há JS ------------------------------ */
  :global(.js) .bf[data-modo='passos'] .bf__passo[hidden] {
    display: none;
  }

  :global(.js) .bf[data-modo='passos'] .bf__passo {
    animation: bf-entrar var(--dur-media) var(--ease);
  }

  @keyframes bf-entrar {
    from {
      opacity: 0;
      transform: translateX(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .bf[data-modo='passos'] .bf__passo {
      animation: none;
    }
  }
</style>

<script>
  import { passos, rotulos } from '../data/briefing';
  import { baseWhats } from '../lib/whatsapp';

  const raiz = document.querySelector<HTMLElement>('[data-briefing]');
  if (raiz) {
    const form = raiz.querySelector<HTMLFormElement>('[data-form]')!;
    const fieldsets = [...raiz.querySelectorAll<HTMLFieldSetElement>('[data-passo]')];
    const btVoltar = raiz.querySelector<HTMLButtonElement>('[data-voltar]')!;
    const btAvancar = raiz.querySelector<HTMLButtonElement>('[data-avancar]')!;
    const btEnviar = raiz.querySelector<HTMLButtonElement>('[data-enviar]')!;
    const cota = raiz.querySelector<HTMLElement>('.bf__cota .cota__valor')!;
    const erro = raiz.querySelector<HTMLElement>('[data-erro]')!;
    const sucesso = raiz.querySelector<HTMLElement>('[data-sucesso]')!;

    let atual = 0;
    raiz.dataset.modo = 'passos';
    btVoltar.hidden = false;
    btAvancar.hidden = false;

    const rastrear = (nome: string, dados: Record<string, unknown> = {}) => {
      (window as any).umami?.track?.(nome, dados);
      (window as any).gtag?.('event', nome, dados);
    };

    function mostrar(i: number) {
      atual = i;
      fieldsets.forEach((fs, k) => {
        fs.hidden = k !== i;
      });
      cota.textContent = `${i + 1} / ${fieldsets.length}`;
      btVoltar.hidden = i === 0;
      btAvancar.hidden = i === fieldsets.length - 1;
      btEnviar.hidden = i !== fieldsets.length - 1;
      erro.hidden = true;
      // foco vai para a pergunta, não para o primeiro input — leitor de tela
      // precisa ouvir a pergunta antes das opções
      const legenda = fieldsets[i].querySelector<HTMLElement>('.bf__texto');
      legenda?.setAttribute('tabindex', '-1');
      legenda?.focus({ preventScroll: true });
      rastrear('briefing_passo', { passo: i + 1, id: fieldsets[i].dataset.passo });
    }

    function respostaDoPasso(i: number): string[] {
      const nome = fieldsets[i].dataset.passo!;
      return [...form.querySelectorAll<HTMLInputElement>(`[name="${nome}"]:checked`)].map(
        (el) => el.value,
      );
    }

    function validarPasso(i: number): boolean {
      if (fieldsets[i].dataset.passo === 'prazo') return true; // validado no envio
      if (respostaDoPasso(i).length === 0) {
        erro.textContent = 'Escolha uma opção para continuar.';
        erro.hidden = false;
        return false;
      }
      return true;
    }

    btAvancar.addEventListener('click', () => {
      if (validarPasso(atual)) mostrar(Math.min(atual + 1, fieldsets.length - 1));
    });

    btVoltar.addEventListener('click', () => mostrar(Math.max(atual - 1, 0)));

    // Escolher uma opção única avança sozinho — menos um clique por passo.
    form.addEventListener('change', (ev) => {
      const alvo = ev.target as HTMLInputElement;
      if (alvo.type !== 'radio') return;
      const fs = alvo.closest<HTMLFieldSetElement>('[data-passo]');
      if (!fs || fs.dataset.passo === 'prazo') return;
      erro.hidden = true;
      window.setTimeout(() => {
        if (Number(fs.dataset.indice) === atual) mostrar(atual + 1);
      }, 220);
    });

    function referencia(): string {
      const d = new Date();
      const carimbo =
        `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}` +
        `${String(d.getDate()).padStart(2, '0')}`;
      const sufixo = Math.floor(Math.random() * 9000 + 1000);
      return `BRF-${carimbo}-${sufixo}`;
    }

    function montarMensagem(ref: string) {
      const dados = new FormData(form);
      const nome = String(dados.get('nome') ?? '').trim();
      const linhas = [
        `Oi, vim pelo site. Meu nome é ${nome}.`,
        '',
        ...passos.map((p) => {
          const vals = respostaDoPasso(passos.indexOf(p)).map((v) => rotulos[v] ?? v);
          const titulo =
            { finalidade: 'Finalidade', regiao: 'Região', area: 'Área', investimento: 'Investimento', prazo: 'Prazo' }[
              p.id
            ] ?? p.id;
          return vals.length ? `${titulo}: ${vals.join(', ')}` : null;
        }).filter(Boolean),
        '',
        `Ref: ${ref}`,
      ];
      return linhas.join('\n');
    }

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();

      const dados = new FormData(form);
      const nome = String(dados.get('nome') ?? '').trim();
      const telefone = String(dados.get('telefone') ?? '').trim();

      if (!nome || telefone.replace(/\D/g, '').length < 10) {
        erro.textContent = 'Preciso do seu nome e de um WhatsApp válido com DDD.';
        erro.hidden = false;
        return;
      }
      if (!dados.get('consentimento')) {
        erro.textContent = 'Marque a autorização de contato para eu poder te responder.';
        erro.hidden = false;
        return;
      }

      const ref = referencia();
      const mensagem = montarMensagem(ref);
      const url = `${baseWhats}?text=${encodeURIComponent(mensagem)}`;

      const payload = {
        ref,
        nome,
        telefone,
        origem: raiz.dataset.origem,
        respostas: Object.fromEntries(
          passos.map((p) => [p.id, respostaDoPasso(passos.indexOf(p))]),
        ),
        enviadoEm: new Date().toISOString(),
      };

      rastrear('briefing_envio', {
        finalidade: payload.respostas.finalidade?.[0],
        regiao: payload.respostas.regiao?.join('|'),
        area: payload.respostas.area?.[0],
        investimento: payload.respostas.investimento?.[0],
        prazo: payload.respostas.prazo?.[0],
      });

      // O webhook é o melhor esforço: se falhar, o WhatsApp abre do mesmo
      // jeito. Nunca deixar o lead preso por causa de integração.
      const webhook = raiz.dataset.webhook;
      if (webhook) {
        try {
          await fetch(webhook, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
            keepalive: true,
          });
        } catch {
          /* segue o baile */
        }
      }

      window.open(url, '_blank', 'noopener');

      form.hidden = true;
      sucesso.hidden = false;
      sucesso.querySelector<HTMLElement>('[data-ref]')!.textContent = `Ref: ${ref}`;
      sucesso.querySelector<HTMLAnchorElement>('[data-link-whats]')!.href = url;
      sucesso.querySelector<HTMLElement>('.bf__sucesso-titulo')?.setAttribute('tabindex', '-1');
      sucesso.querySelector<HTMLElement>('.bf__sucesso-titulo')?.focus();

      // Filtra as sugestões da carteira pelas respostas, se houver na página.
      const finalidade = payload.respostas.finalidade?.[0];
      const regioes = payload.respostas.regiao ?? [];
      document.dispatchEvent(
        new CustomEvent('briefing:concluido', { detail: { finalidade, regioes } }),
      );
    });

    mostrar(0);
    rastrear('briefing_inicio', { origem: raiz.dataset.origem });
  }
</script>
