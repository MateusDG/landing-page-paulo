---
/**
 * BARRA MOBILE
 *
 * Fixa no rodapé abaixo de 900px, porque o polegar está embaixo, não no topo.
 * Duas ações só: ver a carteira e falar. Terceira opção aqui vira ruído.
 */
import { linkWhats } from '../lib/whatsapp';

interface Props {
  imovel?: string;
  titulo?: string;
  areaHa?: number;
  municipio?: string;
  origem?: string;
}

const {
  imovel,
  titulo,
  areaHa,
  municipio,
  origem = imovel ? `barra-mobile:${imovel}` : 'barra-mobile',
} = Astro.props;
const contextual = Boolean(imovel);
const href = linkWhats({ origem, imovel, titulo, areaHa, municipio, intencao: contextual ? 'interesse' : undefined });
---

<div class="bm">
  <a class="bm__item" href={contextual ? '#fotos' : '/imoveis/'}>
    <span class="rotulo">{contextual ? 'Ver fotos' : 'Ver imóveis'}</span>
  </a>
  <a
    class="bm__item bm__item--whats"
    href={href}
    target="_blank"
    rel="noopener"
    data-evento="whats_clique"
    data-conversao="whats_clique"
    data-tipo="whatsapp"
    data-origem={origem}
    data-imovel={imovel}
  >
    <span class="rotulo">{contextual ? 'Tenho interesse' : 'WhatsApp'}</span>
  </a>
</div>

<style>
  .bm {
    display: none;
  }

  @media (max-width: 900px) {
    .bm {
      display: grid;
      grid-template-columns: 1fr 1fr;
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: var(--z-barra-mobile);
      background: color-mix(in srgb, var(--papel) 96%, transparent);
      border-top: var(--borda);
      backdrop-filter: blur(10px);
      /* respeita a área segura do iPhone */
      padding-bottom: env(safe-area-inset-bottom, 0);
    }

    .bm__item {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 56px;
      text-decoration: none;
      color: var(--grafite);
    }

    /* .rotulo traz cor própria; aqui ela precisa herdar do item, senão o
       texto sobre o fundo terra cai para um contraste insuficiente. */
    .bm__item .rotulo {
      color: inherit;
    }

    .bm__item + .bm__item {
      border-left: var(--borda);
    }

    .bm__item--whats {
      background: var(--conilon);
      color: var(--papel);
      border-left-color: var(--conilon);
    }

    /* Impede que a barra cubra o fim do conteúdo. */
    :global(body) {
      padding-bottom: calc(56px + env(safe-area-inset-bottom, 0px));
    }
  }
</style>
