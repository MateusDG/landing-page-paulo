---
/**
 * RODAPÉ-FICHA
 *
 * O rodapé reúne contato, navegação e a data real da carteira.
 */
import { corretor, navRodape } from '../data/site';
import { dataCurta } from '../lib/format';
import { getCollection } from 'astro:content';
import ContatoWhats from './ContatoWhats.astro';
import { imovelPublicado } from '../lib/publicacao';

const imoveis = (await getCollection('imoveis')).filter(imovelPublicado);
const ativas = imoveis.filter((i) => i.data.status === 'ativa').length;
const ultima = imoveis
  .map((i) => i.data.atualizadoEm)
  .sort((a, b) => b.getTime() - a.getTime())[0];
const ano = new Date().getFullYear();
---

<footer class="rod">
  <div class="env">
    <div class="rod__grade">
      <div class="rod__marca">
        <div class="rod__identidade">
          <picture class="rod__logo-quadro">
            <source type="image/webp" srcset="/logo-160.webp 1x, /logo-320.webp 2x" />
            <img
              class="rod__logo"
              src="/logo-1200.png"
              alt=""
              width="1200"
              height="1200"
              loading="lazy"
            />
          </picture>
          <div class="rod__identidade-texto">
            <p>{corretor.nome}</p>
            <span>{corretor.papel} · Espírito Santo</span>
          </div>
        </div>

        <div class="rod__contato" id="contato-whatsapp">
          <ContatoWhats origem="rodape" />
        </div>
      </div>

      <nav class="rod__nav" aria-label="Carteira">
        <p class="rotulo rod__titulo">Carteira</p>
        <ul>
          {
            navRodape.carteira.map((l) => (
              <li>
                <a href={l.href}>{l.rotulo}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="rod__nav" aria-label="Site">
        <p class="rotulo rod__titulo">Site</p>
        <ul>
          {
            navRodape.site.map((l) => (
              <li>
                <a href={l.href}>{l.rotulo}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="rod__base">
      <p class="rotulo rotulo--fraco rod__estado">
        Carteira atualizada em {ultima ? dataCurta(ultima) : 'data pendente'} · {ativas} áreas
        ativas
      </p>
      <p class="rod__aviso">
        Informações fornecidas pelos proprietários e atualizadas na data
        indicada em cada ficha. Podem sofrer alteração e não constituem oferta
        vinculante.
      </p>
      <p class="rotulo rotulo--fraco">
        © {ano} {corretor.nome} · Imóveis rurais no Espírito Santo
      </p>
      <p class="rod__credito">
        Feito e administrado por
        <a
          href="https://wa.me/5527998619377"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Falar com Mateus Diniz pelo WhatsApp"
        >Mateus Diniz</a>.
      </p>
    </div>
  </div>
</footer>

<style>
  .rod {
    border-top: var(--borda-2);
    padding-top: var(--s-8);
    padding-bottom: var(--s-7);
    background: var(--papel);
  }

  .rod__grade {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) repeat(2, minmax(0, 1fr));
    gap: var(--s-7) var(--gutter);
  }

  .rod__identidade {
    display: flex;
    align-items: center;
    gap: var(--s-4);
  }

  .rod__logo-quadro {
    display: block;
    flex: none;
    width: 88px;
    height: 88px;
    overflow: hidden;
    border: var(--borda);
    background: var(--marmore);
  }

  .rod__logo {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rod__identidade-texto {
    display: grid;
    gap: var(--s-1);
  }

  .rod__identidade-texto p {
    font-family: var(--f-display);
    font-size: var(--t-h3);
    font-weight: 600;
    line-height: var(--lh-titulo);
  }

  .rod__identidade-texto span {
    color: var(--grafite-70);
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: 0.04em;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .rod__contato {
    margin-top: var(--s-6);
  }

  .rod__titulo {
    color: var(--grafite);
    padding-bottom: var(--s-3);
    border-bottom: var(--borda);
    margin-bottom: var(--s-4);
  }

  .rod__nav ul {
    display: grid;
    gap: var(--s-3);
  }

  .rod__nav a {
    font-size: var(--t-peq);
    color: var(--grafite-70);
    text-decoration: none;
    transition: color var(--dur-rapida) var(--ease);
  }

  .rod__nav a:hover {
    color: var(--terra);
  }

  .rod__base {
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: var(--borda);
    display: grid;
    gap: var(--s-4);
  }

  .rod__estado {
    color: var(--grafite);
  }

  .rod__aviso {
    font-size: var(--t-micro);
    line-height: 1.55;
    color: var(--grafite-70);
    max-width: 62ch;
  }

  .rod__credito {
    font-size: var(--t-micro);
    line-height: 1.55;
    color: var(--grafite-70);
  }

  .rod__credito a {
    color: var(--grafite);
    text-underline-offset: 0.18em;
    transition: color var(--dur-rapida) var(--ease);
  }

  .rod__credito a:hover,
  .rod__credito a:focus-visible {
    color: var(--terra);
  }

  @media (max-width: 900px) {
    .rod__grade {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rod__marca {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .rod__grade {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
