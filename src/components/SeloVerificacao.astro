---
/**
 * SELO DE VERIFICAÇÃO, carimbo desenhado, não ícone de biblioteca.
 *
 * Usado nos 14 pontos do protocolo e no estado documental de cada imóvel.
 * A informação NÃO é transmitida só por cor: cada estado tem forma e rótulo
 * textual próprios (requisito de acessibilidade, e também de honestidade,  * um "verde" sem legenda esconde o que significa).
 */
interface Props {
  estado: 'ok' | 'pendente' | 'na';
  /** Texto acessível. Sem ele o selo é decorativo. */
  rotulo?: string;
  tamanho?: number;
}

const { estado, rotulo, tamanho = 18 } = Astro.props;

const descricao: Record<Props['estado'], string> = {
  ok: 'conferido',
  pendente: 'pendente',
  na: 'não se aplica',
};
---

<span class:list={['selo', `selo--${estado}`]} title={rotulo ? undefined : descricao[estado]}>
  <svg
    width={tamanho}
    height={tamanho}
    viewBox="0 0 18 18"
    fill="none"
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
  >
    <rect
      x="0.6"
      y="0.6"
      width="16.8"
      height="16.8"
      stroke="currentColor"
      stroke-width="1"
    />
    {
      estado === 'ok' && (
        <path
          d="M4.4 9.3 L7.4 12.3 L13.6 5.6"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="square"
        />
      )
    }
    {
      estado === 'pendente' && (
        <path d="M4.6 9 H13.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" />
      )
    }
    {
      estado === 'na' && (
        <path
          d="M4.4 13.6 L13.6 4.4"
          stroke="currentColor"
          stroke-width="1"
          stroke-linecap="square"
        />
      )
    }
  </svg>
  <span class="so-leitor">{rotulo ? `${rotulo}: ${descricao[estado]}` : descricao[estado]}</span>
</span>

<style>
  .selo {
    display: inline-flex;
    flex: none;
    line-height: 0;
  }

  .selo--ok {
    color: var(--verificado);
  }

  .selo--pendente {
    color: var(--terra);
  }

  .selo--na {
    color: var(--grafite-40);
  }
</style>
