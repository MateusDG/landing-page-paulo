---
/**
 * ACORDEÃO
 *
 * Usa <details>/<summary> nativos: semântica correta, funciona sem JS,
 * pesquisável pelo Ctrl+F do navegador em navegadores modernos.
 * Sem ícone de "+" girando, só filete e mudança de peso tipográfico.
 */
interface Item {
  pergunta: string;
  resposta: string;
  /** Linha extra em mono acima da resposta (ex.: sigla do termo). */
  etiqueta?: string;
}

interface Props {
  itens: readonly Item[];
  /** Abre o primeiro por padrão, dá a pista de que é expansível. */
  abrirPrimeiro?: boolean;
}

const { itens, abrirPrimeiro = true } = Astro.props;
---

<div class="acd">
  {
    itens.map((item, i) => (
      <details class="acd__item" open={abrirPrimeiro && i === 0}>
        <summary class="acd__gatilho">
          <span class="acd__pergunta">{item.pergunta}</span>
          {item.etiqueta && <span class="rotulo rotulo--fraco acd__etiqueta">{item.etiqueta}</span>}
          <span class="acd__marca" aria-hidden="true" />
        </summary>
        <div class="acd__corpo">
          <p>{item.resposta}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .acd {
    border-top: var(--borda);
  }

  .acd__item {
    border-bottom: var(--borda-f);
  }

  .acd__gatilho {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--s-4);
    align-items: baseline;
    padding-block: var(--s-5);
    cursor: pointer;
    list-style: none;
    min-height: 44px;
  }

  .acd__gatilho::-webkit-details-marker {
    display: none;
  }

  .acd__pergunta {
    font-family: var(--f-display);
    font-size: var(--t-h3);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    max-width: 46ch;
    transition: color var(--dur-rapida) var(--ease);
  }

  .acd__gatilho:hover .acd__pergunta {
    color: var(--terra);
  }

  .acd__item[open] .acd__pergunta {
    font-weight: 600;
  }

  /* Marca: um traço que vira dois. Não gira, não é um "+". */
  .acd__marca {
    position: relative;
    width: 14px;
    height: 14px;
    flex: none;
    align-self: center;
  }

  .acd__marca::before,
  .acd__marca::after {
    content: '';
    position: absolute;
    background: var(--grafite);
    transition: opacity var(--dur-rapida) var(--ease);
  }

  .acd__marca::before {
    inset-inline: 0;
    top: 50%;
    height: 1px;
  }

  .acd__marca::after {
    inset-block: 0;
    left: 50%;
    width: 1px;
  }

  .acd__item[open] .acd__marca::after {
    opacity: 0;
  }

  .acd__corpo {
    padding-bottom: var(--s-6);
    max-width: var(--medida);
    font-size: var(--t-corpo);
    line-height: var(--lh-corpo);
    color: var(--grafite-70);
  }

  @media (max-width: 560px) {
    .acd__etiqueta {
      display: none;
    }
  }
</style>
