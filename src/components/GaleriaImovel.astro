---
/**
 * GALERIA DO IMÓVEL
 *
 * A primeira foto funciona como capa e a faixa de miniaturas mantém todas as
 * imagens visíveis. Cada miniatura abre a mesma galeria em tela ampliada,
 * com navegação por setas, teclado, gesto de arrastar e Escape para fechar.
 */
interface Foto {
  src: string;
  alt: string;
  legenda?: string;
  largura?: number;
  altura?: number;
}

interface Props {
  fotos: Foto[];
  municipio: string;
}

const { fotos, municipio } = Astro.props;

const urlWebp = (src: string, largura: number) =>
  src.replace(/\.(?:jpe?g|png|webp)$/i, `-${largura}.webp`);
const srcsetWebp = (src: string) =>
  [320, 640, 960].map((largura) => `${urlWebp(src, largura)} ${largura}w`).join(', ');

const shotList = [
  ['A chegada', 'A estrada de acesso vista do carro. Acesso é a objeção nº 1.'],
  ['A porteira', 'Ancora o lugar e mostra o estado da entrada.'],
  ['A vista da sede', 'É o que o comprador vai olhar todo dia.'],
  ['A água', 'Nascente, córrego, açude ou poço. Fator de preço nº 1.'],
  ['O solo na mão', 'Close. Prova de terreno e a imagem mais forte do conjunto.'],
  ['A lavoura ou o pasto', 'Plano médio, estado real da produção.'],
  ['As benfeitorias', 'Incluindo o que está ruim. Honestidade é credibilidade.'],
  ['Cerca e divisa', 'Sinaliza cuidado com limites.'],
  ['Energia', 'Poste, padrão, bitola. Objeção prática comum.'],
  ['A vizinhança', 'O que se vê da divisa. Ninguém mostra; todos querem saber.'],
  ['Uma aérea só', 'Baixa altitude, para entender a forma da área.'],
  ['O detalhe humano', 'Botina, mão, cachorro, café no fogão. É o que faz parecer real.'],
];
---

{
  fotos.length > 0 ? (
    <div class="gal" data-galeria>
      <div class="gal__hero">
        <button
          class="gal__abrir"
          type="button"
          data-gal-foto
          data-gal-main-trigger
          data-gal-index="0"
          aria-label={`Abrir foto 1 de ${fotos.length}: ${fotos[0].alt}`}
        >
          <picture>
            <source
              data-gal-main-source
              type="image/webp"
              srcset={srcsetWebp(fotos[0].src)}
              sizes="(max-width: 700px) calc(100vw - 42px), 1120px"
            />
            <img
              data-gal-main
              src={fotos[0].src}
              alt={fotos[0].alt}
              width={fotos[0].largura ?? 1600}
              height={fotos[0].altura ?? 1067}
              loading="lazy"
              decoding="async"
              fetchpriority="low"
            />
          </picture>
          <span class="gal__abrir-hint">Abrir galeria</span>
        </button>

        <div class="gal__nav" aria-label="Navegar pelas fotos">
          <button type="button" class="gal__nav-btn" data-gal-prev aria-label="Foto anterior">
            <span aria-hidden="true">←</span>
            <span class="sr-only">Anterior</span>
          </button>
          <button type="button" class="gal__nav-btn" data-gal-next aria-label="Próxima foto">
            <span aria-hidden="true">→</span>
            <span class="sr-only">Próxima</span>
          </button>
        </div>
      </div>

      <div class="gal__info">
        <p class="rotulo" data-gal-contador aria-live="polite">1 / {fotos.length}</p>
        <p class="peq secundario">Selecione uma foto ou use as setas</p>
        <p class="gal__legenda" data-gal-main-caption>{fotos[0].legenda ?? ''}</p>
      </div>

      <div class="gal__thumbs" role="list" aria-label="Miniaturas das fotos">
        {fotos.map((f, i) => (
          <div role="listitem">
            <button
              class="gal__thumb"
              type="button"
              data-gal-foto
              data-gal-thumb
              data-gal-index={i}
              data-gal-src={f.src}
              data-gal-alt={f.alt}
              data-gal-legenda={f.legenda ?? ''}
              data-gal-largura={f.largura ?? 1600}
              data-gal-altura={f.altura ?? 1067}
              aria-label={`Ver foto ${i + 1} de ${fotos.length}: ${f.alt}`}
              aria-current={i === 0 ? 'true' : undefined}
            >
              <picture>
                <source type="image/webp" srcset={urlWebp(f.src, 160)} />
                <img
                  src={f.src}
                  alt={`Miniatura: ${f.alt}`}
                  width={f.largura ?? 1600}
                  height={f.altura ?? 1067}
                  loading="lazy"
                  decoding="async"
                  fetchpriority="low"
                />
              </picture>
              <span class="gal__thumb-n">{String(i + 1).padStart(2, '0')}</span>
            </button>
          </div>
        ))}
      </div>

      <dialog class="gal__dialog" data-gal-dialog aria-labelledby="galeria-titulo" aria-modal="true">
        <div class="gal__dialog-inner">
          <header class="gal__dialog-head">
            <p class="rotulo" id="galeria-titulo">Fotografia</p>
            <button type="button" class="gal__fechar" data-gal-close>
              Fechar <span aria-hidden="true">×</span>
            </button>
          </header>

          <div class="gal__dialog-view">
            <button type="button" class="gal__dialog-nav" data-gal-prev aria-label="Foto anterior">
              <span aria-hidden="true">←</span>
              <span class="sr-only">Anterior</span>
            </button>
            <figure class="gal__dialog-figure">
              <img data-gal-dialog-img alt="" decoding="async" />
              <figcaption data-gal-dialog-caption>{fotos[0].legenda ?? ''}</figcaption>
            </figure>
            <button type="button" class="gal__dialog-nav" data-gal-next aria-label="Próxima foto">
              <span aria-hidden="true">→</span>
              <span class="sr-only">Próxima</span>
            </button>
          </div>

          <p class="gal__dialog-status rotulo" data-gal-dialog-status aria-live="polite">
            Foto 1 de {fotos.length}
          </p>
        </div>
      </dialog>
    </div>
  ) : (
    <div class="shot">
      <div class="shot__cab">
        <p class="rotulo rotulo--terra">Fotografia pendente</p>
        <p class="shot__intro">
          Esta área ainda não foi fotografada. Quando for, entram estas doze
          fotos e nenhuma imagem de banco. As fotos de {municipio} são feitas por mim,
          na área, no dia da vistoria.
        </p>
      </div>

      <ol class="shot__lista">
        {shotList.map(([titulo, porque], i) => (
          <li class="shot__item">
            <span class="mono shot__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="shot__quadro" aria-hidden="true" />
            <span class="shot__texto">
              <span class="shot__titulo">{titulo}</span>
              <span class="shot__porque">{porque}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .gal {
    display: grid;
    gap: var(--s-4);
  }

  .gal__hero {
    position: relative;
    border: var(--borda);
    background: var(--grafite);
    overflow: hidden;
  }

  .gal__abrir {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: zoom-in;
  }

  .gal__abrir img {
    display: block;
    width: 100%;
    max-height: min(62vw, 560px);
    min-height: 280px;
    object-fit: contain;
    background: var(--grafite);
  }

  .gal__abrir picture,
  .gal__thumb picture {
    display: block;
  }

  .gal__abrir-hint {
    position: absolute;
    right: var(--s-4);
    bottom: var(--s-4);
    padding: var(--s-2) var(--s-3);
    background: rgb(28 29 27 / 78%);
    color: var(--papel);
    font-family: var(--f-mono);
    font-size: var(--t-micro);
    letter-spacing: var(--tracking-rotulo);
    text-transform: uppercase;
  }

  .gal__nav {
    position: absolute;
    inset: 50% var(--s-4) auto;
    display: flex;
    justify-content: space-between;
    gap: var(--s-2);
    transform: translateY(-50%);
    pointer-events: none;
  }

  .gal__nav-btn {
    pointer-events: auto;
  }

  .gal__nav-btn,
  .gal__dialog-nav,
  .gal__fechar {
    display: inline-grid;
    place-items: center;
    border: 1px solid rgb(245 241 232 / 55%);
    background: rgb(28 29 27 / 82%);
    color: var(--papel);
    cursor: pointer;
    transition: background-color var(--dur-rapida) var(--ease), color var(--dur-rapida) var(--ease);
  }

  .gal__nav-btn {
    width: 2.75rem;
    height: 2.75rem;
    font-size: 1.3rem;
  }

  .gal__nav-btn:hover,
  .gal__nav-btn:focus-visible,
  .gal__dialog-nav:hover,
  .gal__dialog-nav:focus-visible,
  .gal__fechar:hover,
  .gal__fechar:focus-visible {
    background: var(--papel);
    color: var(--grafite);
  }

  .gal__info {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    gap: var(--s-4);
    align-items: baseline;
  }

  .gal__info > p {
    margin: 0;
  }

  .gal__legenda {
    justify-self: end;
    color: var(--grafite-70);
    font-size: var(--t-peq);
    text-align: right;
  }

  .gal__thumbs {
    display: flex;
    gap: var(--s-3);
    overflow-x: auto;
    padding: var(--s-2) var(--s-1) var(--s-3);
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .gal__thumb {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 2px solid transparent;
    background: var(--papel-2);
    cursor: pointer;
    scroll-snap-align: start;
  }

  .gal__thumbs > [role='listitem'] {
    flex: 0 0 clamp(5.25rem, 14vw, 8rem);
  }

  .gal__thumb:hover,
  .gal__thumb:focus-visible,
  .gal__thumb[aria-current='true'] {
    border-color: var(--terra);
  }

  .gal__thumb img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .gal__thumb-n {
    position: absolute;
    left: var(--s-1);
    bottom: var(--s-1);
    padding: 0.15rem 0.3rem;
    background: rgb(28 29 27 / 78%);
    color: var(--papel);
    font-family: var(--f-mono);
    font-size: var(--t-micro);
  }

  .gal__dialog {
    width: min(96vw, 1120px);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    border: var(--borda);
    background: var(--grafite);
    color: var(--papel);
  }

  .gal__dialog::backdrop {
    background: rgb(16 17 15 / 84%);
  }

  .gal__dialog-inner {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-4);
  }

  .gal__dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
  }

  .gal__dialog-head p {
    margin: 0;
    color: var(--papel);
  }

  .gal__fechar {
    grid-auto-flow: column;
    gap: var(--s-2);
    min-height: 2.4rem;
    padding: var(--s-2) var(--s-3);
    font-family: inherit;
    font-size: var(--t-peq);
  }

  .gal__fechar span {
    font-size: 1.4rem;
    line-height: 0.8;
  }

  .gal__dialog-view {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 3rem;
    gap: var(--s-3);
    align-items: center;
  }

  .gal__dialog-nav {
    width: 3rem;
    height: 3rem;
    font-size: 1.4rem;
  }

  .gal__dialog-figure {
    display: grid;
    gap: var(--s-3);
    min-width: 0;
    margin: 0;
  }

  .gal__dialog-figure img {
    display: block;
    width: 100%;
    max-height: 76vh;
    min-height: 180px;
    object-fit: contain;
  }

  .gal__dialog-figure figcaption {
    color: var(--papel-2);
    font-size: var(--t-peq);
    line-height: 1.5;
    text-align: center;
  }

  .gal__dialog-status {
    margin: 0;
    color: var(--papel-2);
    text-align: center;
  }

  /* --- Estado sem fotos ------------------------------------------------- */
  .shot {
    border: var(--borda);
    background: var(--marmore);
    padding: clamp(var(--s-5), 4vw, var(--s-7));
  }

  .shot__intro {
    margin-top: var(--s-3);
    font-size: var(--t-peq);
    line-height: 1.6;
    color: var(--grafite-70);
    max-width: 56ch;
  }

  .shot__lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--gutter);
    margin-top: var(--s-6);
    padding-top: var(--s-6);
    border-top: var(--borda);
  }

  .shot__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    gap: var(--s-2) var(--s-3);
    align-items: start;
  }

  .shot__n {
    font-size: var(--t-micro);
    color: var(--terra);
    letter-spacing: var(--tracking-rotulo);
    grid-row: 1;
  }

  .shot__quadro {
    grid-column: 1 / -1;
    grid-row: 2;
    aspect-ratio: 3 / 2;
    border: 1px dashed var(--filete);
    background: var(--papel-2);
  }

  .shot__texto {
    grid-row: 1;
    display: grid;
    gap: 2px;
  }

  .shot__titulo {
    font-size: var(--t-peq);
    font-weight: 600;
  }

  .shot__porque {
    font-size: var(--t-micro);
    line-height: 1.5;
    color: var(--grafite-70);
  }

  @media (max-width: 700px) {
    .gal__abrir img {
      max-height: 68vw;
      min-height: 220px;
    }

    .gal__info {
      grid-template-columns: auto 1fr;
      gap: var(--s-2) var(--s-4);
    }

    .gal__info .secundario {
      justify-self: end;
      text-align: right;
    }

    .gal__legenda {
      grid-column: 1 / -1;
      justify-self: start;
      text-align: left;
    }

    .gal__dialog {
      width: 100vw;
      max-height: 100vh;
      border-inline: 0;
    }

    .gal__dialog-inner {
      min-height: 100vh;
      padding: var(--s-3);
    }

    .gal__dialog-view {
      grid-template-columns: 2.5rem minmax(0, 1fr) 2.5rem;
      gap: var(--s-2);
    }

    .gal__dialog-nav {
      width: 2.5rem;
      height: 2.5rem;
    }

    .gal__dialog-figure img {
      max-height: 72vh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gal__nav-btn,
    .gal__dialog-nav,
    .gal__fechar {
      transition: none;
    }
  }
</style>

<script>
  interface GaleriaItem {
    src: string;
    alt: string;
    legenda: string;
    largura: number;
    altura: number;
  }

  const root = document.querySelector<HTMLElement>('[data-galeria]');

  if (root) {
    const dialog = root.querySelector<HTMLDialogElement>('[data-gal-dialog]');
    const mainTrigger = root.querySelector<HTMLButtonElement>('[data-gal-main-trigger]');
    const mainImage = root.querySelector<HTMLImageElement>('[data-gal-main]');
    const mainSource = root.querySelector<HTMLSourceElement>('[data-gal-main-source]');
    const mainCaption = root.querySelector<HTMLElement>('[data-gal-main-caption]');
    const counter = root.querySelector<HTMLElement>('[data-gal-contador]');
    const dialogImage = root.querySelector<HTMLImageElement>('[data-gal-dialog-img]');
    const dialogCaption = root.querySelector<HTMLElement>('[data-gal-dialog-caption]');
    const dialogStatus = root.querySelector<HTMLElement>('[data-gal-dialog-status]');
    const closeButton = root.querySelector<HTMLButtonElement>('[data-gal-close]');
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-gal-thumb]')];
    const items: GaleriaItem[] = thumbs.map((button) => ({
      src: button.dataset.galSrc ?? button.querySelector('img')?.getAttribute('src') ?? '',
      alt: button.dataset.galAlt ?? button.querySelector('img')?.alt.replace(/^Miniatura: /, '') ?? '',
      legenda: button.dataset.galLegenda ?? '',
      largura: Number(button.dataset.galLargura ?? button.querySelector('img')?.getAttribute('width') ?? 1600),
      altura: Number(button.dataset.galAltura ?? button.querySelector('img')?.getAttribute('height') ?? 1067),
    }));

    const gerarSrcsetWebp = (src: string) =>
      [320, 640, 960]
        .map((largura) => `${src.replace(/\.(?:jpe?g|png|webp)$/i, `-${largura}.webp`)} ${largura}w`)
        .join(', ');

    /* Lê os dados do HTML renderizado para que as imagens sejam substituíveis
       no markdown sem duplicar informação na lógica da galeria. */
    thumbs.forEach((button, index) => {
      const foto = button.querySelector<HTMLImageElement>('img');
      if (!foto || !items[index]) return;
      items[index] = {
        src: items[index].src,
        alt: foto.alt.replace(/^Miniatura: /, ''),
        legenda: button.dataset.galLegenda ?? '',
        largura: Number(foto.getAttribute('width') ?? 1600),
        altura: Number(foto.getAttribute('height') ?? 1067),
      };
    });

    let index = 0;
    let retorno: HTMLButtonElement | null = null;
    let toqueInicial: number | null = null;

    const render = (proximo: number, rolarMiniatura = true) => {
      if (!items.length) return;
      index = (proximo + items.length) % items.length;
      const item = items[index];

      if (mainImage) {
        mainImage.src = item.src;
        mainImage.alt = item.alt;
        mainImage.width = item.largura;
        mainImage.height = item.altura;
      }
      if (mainSource) mainSource.srcset = gerarSrcsetWebp(item.src);
      if (mainTrigger) {
        mainTrigger.dataset.galIndex = String(index);
        mainTrigger.setAttribute('aria-label', `Abrir foto ${index + 1} de ${items.length}: ${item.alt}`);
      }
      if (mainCaption) {
        mainCaption.textContent = item.legenda;
        mainCaption.hidden = !item.legenda;
      }
      if (counter) counter.textContent = `${index + 1} / ${items.length}`;
      if (dialogImage && dialog?.open) {
        dialogImage.src = item.src;
        dialogImage.alt = item.alt;
        dialogImage.width = item.largura;
        dialogImage.height = item.altura;
      }
      if (dialogCaption) {
        dialogCaption.textContent = item.legenda;
        dialogCaption.hidden = !item.legenda;
      }
      if (dialogStatus) dialogStatus.textContent = `Foto ${index + 1} de ${items.length}`;

      thumbs.forEach((thumb, thumbIndex) => {
        if (thumbIndex === index) thumb.setAttribute('aria-current', 'true');
        else thumb.removeAttribute('aria-current');
      });
      if (rolarMiniatura) {
        thumbs[index]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
      }
    };

    const fechar = () => {
      if (dialog?.open) dialog.close();
      retorno?.focus({ preventScroll: true });
      retorno = null;
    };

    const abrir = (proximo: number, trigger: HTMLButtonElement) => {
      if (!dialog) return;
      retorno = trigger;
      if (!dialog.open) dialog.showModal();
      render(proximo);
      closeButton?.focus({ preventScroll: true });
    };

    root.querySelectorAll<HTMLButtonElement>('[data-gal-foto]').forEach((button) => {
      button.addEventListener('click', () => abrir(Number(button.dataset.galIndex ?? 0), button));
    });

    root.querySelectorAll<HTMLButtonElement>('[data-gal-prev]').forEach((button) => {
      button.addEventListener('click', () => render(index - 1));
    });

    root.querySelectorAll<HTMLButtonElement>('[data-gal-next]').forEach((button) => {
      button.addEventListener('click', () => render(index + 1));
    });

    closeButton?.addEventListener('click', fechar);
    dialog?.addEventListener('cancel', (event) => {
      event.preventDefault();
      fechar();
    });
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) fechar();
    });
    dialog?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        fechar();
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        render(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        render(index + 1);
      }
    });
    dialog?.addEventListener(
      'touchstart',
      (event) => {
        toqueInicial = event.touches[0]?.clientX ?? null;
      },
      { passive: true },
    );
    dialog?.addEventListener(
      'touchend',
      (event) => {
        if (toqueInicial == null) return;
        const deslocamento = (event.changedTouches[0]?.clientX ?? toqueInicial) - toqueInicial;
        if (Math.abs(deslocamento) > 45) render(index + (deslocamento < 0 ? 1 : -1));
        toqueInicial = null;
      },
      { passive: true },
    );

    /* A renderização inicial não pode alterar a posição da página. Sem isso,
       abrir uma ficha pela carteira fazia o navegador saltar até a galeria. */
    render(0, false);
  }
</script>
