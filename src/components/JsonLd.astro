---
/**
 * JSON-LD, dados estruturados.
 * Um único ponto de saída para todo schema.org do site.
 */
interface Props {
  dados: Record<string, unknown> | Record<string, unknown>[];
}

const { dados } = Astro.props;
/* Evita que um texto futuro contendo `</script>` encerre o bloco e injete
   HTML executavel. Os escapes continuam sendo JSON valido para o Google. */
const json = JSON.stringify(dados)
  .replace(/&/g, '\\u0026')
  .replace(/</g, '\\u003c')
  .replace(/>/g, '\\u003e')
  .replace(/\u2028/g, '\\u2028')
  .replace(/\u2029/g, '\\u2029');
---

<script type="application/ld+json" set:html={json} is:inline />
