{
  "name": "corretor-rural-es",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Landing page para compra e venda de imóveis rurais no Espírito Santo: fazendas, chácaras, sítios e terrenos.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/finalizar-build-seguro.mjs",
    "preview": "astro preview",
    "check": "astro check",
