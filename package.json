    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.2.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "lightningcss": "^1.33.0",
    "typescript": "^7.0.2"
  }
}
