    "sync": "astro sync",
    "shot": "node scripts/shot.mjs",
    "fonts": "./scripts/build-fonts.sh",
    "images": "node scripts/preparar-imagens.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/fraunces": "^5.3.0",
