# Endereco publico do site, sem barra no final
PUBLIC_SITE_URL=https://valdecimoveis.com.br
PUBLIC_WHATSAPP=5527999309535

# Opcional: codigo da verificacao por tag HTML do Google Search Console.
# Se verificar a propriedade de Dominio pelo DNS, deixe vazio.
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Perfis oficiais. Preencha somente com URLs que pertencem ao negocio.
PUBLIC_GOOGLE_BUSINESS_URL=
PUBLIC_INSTAGRAM_URL=
PUBLIC_FACEBOOK_URL=

# Umami e opcional. Deixe os dois campos vazios se nao utiliza esse servico.
# URL do script de monitoramento fornecida pelo Umami.
PUBLIC_UMAMI_SRC=
# Identificador do site fornecido pelo painel do Umami.
PUBLIC_UMAMI_ID=

# Google Tag Manager e Google Ads. Esses IDs sao publicos e podem ficar no build.
PUBLIC_GTM_ID=GTM-P3LBCHF8
PUBLIC_GOOGLE_ADS_ID=AW-18371455109
